<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Obsidian, Act I: Wolves At The Gate</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Twenty years ago, a grand city was overrun by a thousand Horde soldiers searching for a runestone. Within the city of Half-Moon, only one survivor escaped: a child, rescued by the king of Bright Moon. Now, this child must find her place in a war she's thrust in the middle of after a soldier harboring an ancient power finds her way to Bright Moon's doorstep. Meanwhile, after being kidnapped by a powerful dark sorceress, that child's sister must grapple with the beginnings of a downward spiral that threatens to turn her into the very thing she despises.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>AzimuthStars</rdf:li>
        </rdf:Seq>
      </dc:creator>
