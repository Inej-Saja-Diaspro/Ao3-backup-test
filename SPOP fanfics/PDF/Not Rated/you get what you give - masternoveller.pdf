<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">You Get What You Give</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora spends one week at Horde Enterprises - a construction company.&lt;br /&gt;She's paired up with the labourer, a magicat called Catra.&lt;br /&gt;And since the supervisor is never there, she ends up shadowing the magicat.&lt;br /&gt;Opening her eyes to the shoddy work environment and work practices at H.E.&lt;/p&gt;&lt;p&gt;Or&lt;/p&gt;&lt;p&gt;Loosely based on undercover boss - very loosely (no one is in disguise).&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
