<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Room For Four</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra and Adora are sharing a hotel room with Rumi and Mira since all the other rooms have been taken by the band's fans.&lt;br&gt;
It also doesn't help that Bobby also forgot to book his singers into a hotel either...&lt;br&gt;
Lucky for all involved, they managed to get two rooms.&lt;/p&gt;&lt;p&gt;Unfortunately (or fortunately) Mira had already kicked Zoey out into the second room to get alone time with Rumi.&lt;br&gt;
It also unfortunately (or fortunately) that Catra and Adora end up staying in the same room as them.&lt;/p&gt;&lt;p&gt;At some point within their stay, perhaps one or both couples start to feel a little... amorous....&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Not Rated</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>KPop Demon Hunters (2025)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Mira/Rumi (KPop Demon Hunters)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Rumi (KPop Demon Hunters)</rdf:li>
          <rdf:li>Mira (KPop Demon Hunters)</rdf:li>
          <rdf:li>Zoey (KPop Demon Hunters)</rdf:li>
          <rdf:li>Catra and Mira are friends</rdf:li>
          <rdf:li>Catra is in Love with Adora (She-Ra)</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Catra Has a Penis (She-Ra)</rdf:li>
          <rdf:li>Mira Has a Penis (KPop Demon Hunters)</rdf:li>
          <rdf:li>Concerts</rdf:li>
          <rdf:li>Sharing a Room</rdf:li>
          <rdf:li>But not beds</rdf:li>
          <rdf:li>Smut</rdf:li>
          <rdf:li>Not A Lot Of Plot</rdf:li>
          <rdf:li>Making Out</rdf:li>
          <rdf:li>Kisses</rdf:li>
          <rdf:li>Alternate Universe</rdf:li>
          <rdf:li>Top Catra (She-Ra)</rdf:li>
          <rdf:li>Bottom Adora (She-Ra)</rdf:li>
          <rdf:li>Top Mira (KPop Demon Hunters)</rdf:li>
          <rdf:li>Bottom Rumi (KPop Demon Hunters)</rdf:li>
          <rdf:li>She-Ra is mentioned</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
