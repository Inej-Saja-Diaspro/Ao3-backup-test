<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Strands of Pain</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Entrapta has always been a reserved person and never knows how to handle emotions well.&lt;/p&gt;&lt;p&gt;When Hordak finds her alone, mask down and caressing her long pigtail, he knows that's never a good sign. He soon learns just how the Mermaid princess treats her at Castle Brightmoon.&lt;/p&gt;&lt;p&gt;Even Entrapta has limits, especially if you pull her extra sensitive hair.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>AutisticValue</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Not Rated</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
