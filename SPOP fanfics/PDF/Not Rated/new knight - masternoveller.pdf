          <rdf:li>Princess Adora (She-Ra)</rdf:li>
          <rdf:li>Knight Catra (She-Ra)</rdf:li>
          <rdf:li>King Randor - Freeform</rdf:li>
          <rdf:li>Oblivious Catra (She-Ra)</rdf:li>
          <rdf:li>Oblivious Adora (She-Ra)</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Duty and Honour</rdf:li>
          <rdf:li>Magicat Catra (She-Ra)</rdf:li>
          <rdf:li>they like each other</rdf:li>
          <rdf:li>Maybe love later?</rdf:li>
          <rdf:li>F/F</rdf:li>
