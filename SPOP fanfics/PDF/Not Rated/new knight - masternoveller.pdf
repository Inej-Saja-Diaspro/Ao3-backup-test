    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">New Knight</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra's a new knight at the castle Grayskull, specially selected by the King himself to protect his daughter, Princess Adora.&lt;br /&gt;It's short, so summary is just as short.&lt;/p&gt;&lt;p&gt;Fluff.&lt;/p&gt;&lt;p&gt;*****************************&lt;br /&gt;Updated - Chapter 3 (Spicy Chapter)&lt;/p&gt;&lt;p&gt;*****************************&lt;br /&gt;Updated - Chapter 4 (Fluff)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
