    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">hot &amp;amp; heavy</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora is on the train, coming back from her first year of university to spend the summer holidays in her hometown. On the way, she reminisces of easier times, when her and Catra were kids with an uncomplicated and unburdened friendship.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Friend0fM4ra</rdf:li>
        </rdf:Seq>
      </dc:creator>
