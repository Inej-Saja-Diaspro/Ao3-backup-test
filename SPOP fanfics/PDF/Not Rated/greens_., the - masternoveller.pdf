<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Greens...</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra doesn't want to go out.&lt;br /&gt;She has work to do, work that she actually loves doing.&lt;br /&gt;So, when Scorpia guilt trips her into going out to celebrate her engagement, the magicat can't refuse.&lt;br /&gt;It's just one drink, right?&lt;/p&gt;&lt;p&gt;Wrong.&lt;/p&gt;&lt;p&gt;But how was Adora supposed to know greens and magicats don't mix so well?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
