<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Our name is Melog</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;â "Can you hear it talking? Please tell me you can hear it talking!" Melog has become an essential part of Catra's everyday life, and they often talk about things. âž&lt;/p&gt;&lt;p&gt;A.K.A; A collection of Melog and Catra interactions&lt;/p&gt;&lt;p&gt;[An She-Ra and the Princesses of Power fanfiction by Starwynn (@ST4RWYNN)]&lt;br /&gt;[`--` by Starwynn]&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>ST4RWYNN</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Not Rated</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Catra &amp; Melog (She-Ra)</rdf:li>
          <rdf:li>(Mentioned) Catra/Adora</rdf:li>
          <rdf:li>(Implied) Catra/Adora</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra Applesauce Meowmeow - Character</rdf:li>
          <rdf:li>Melog - Character</rdf:li>
          <rdf:li>(Mentioned) Adora Happysmile Rainbowfist</rdf:li>
          <rdf:li>(Mentioned) Glimmer Moon</rdf:li>
          <rdf:li>(Mentioned) Bow Woods</rdf:li>
          <rdf:li>Therapy Cat Melog (She-Ra)</rdf:li>
          <rdf:li>They/Them pronouns Melog</rdf:li>
          <rdf:li>Melog is NB</rdf:li>
          <rdf:li>Melog refers to themselves using 'us/we/our' and uses names and 'she/her/he/him/they/them' instead of 'you/your'</rdf:li>
          <rdf:li>This is how i envision Melog's characterization to be</rdf:li>
          <rdf:li>I also gave Glimmer and Bow last names</rdf:li>
          <rdf:li>because nobles</rdf:li>
          <rdf:li>especially Kings and Princesses and Queens</rdf:li>
          <rdf:li>are generally supposed to have last names</rdf:li>
          <rdf:li>Right?</rdf:li>
          <rdf:li>though it isn't explicitly stated in the fic</rdf:li>
          <rdf:li>Glimmer's last name is Moon</rdf:li>
          <rdf:li>and Bow is Bow Woods</rdf:li>
          <rdf:li>Slice of Life</rdf:li>
          <rdf:li>I think?</rdf:li>
          <rdf:li>Melog is like an ancient being who knows nothing about regular customs</rdf:li>
          <rdf:li>they're clueless</rdf:li>
          <rdf:li>Comparable to modern characterization of biblically accurate angels tbh</rdf:li>
          <rdf:li>yay!</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2025-08-12T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
