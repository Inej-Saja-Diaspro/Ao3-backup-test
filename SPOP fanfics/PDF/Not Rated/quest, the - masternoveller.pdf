<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Quest</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra is a thief, just wanting to live her life with the people she's gotten to know.&lt;br /&gt;Until it's all turned upside down.&lt;/p&gt;&lt;p&gt;Adora is on her way to a tournament to compete at the world martial arts championships.&lt;br /&gt;Glimmer and Bow tag along with her for support.&lt;/p&gt;&lt;p&gt;They'll meet, but it won't be in the best circumstances...&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Not Rated</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Magicat Catra (She-Ra)</rdf:li>
          <rdf:li>Thief Catra</rdf:li>
          <rdf:li>Martial Artist Adora</rdf:li>
          <rdf:li>Original Charactors - Freeform</rdf:li>
          <rdf:li>Minor Character Death</rdf:li>
          <rdf:li>Best Friend Squad (She-Ra)</rdf:li>
          <rdf:li>Lesbian Adora (She-Ra)</rdf:li>
          <rdf:li>Lesbian Catra (She-Ra)</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Catra is in Love with Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer is a Good Friend (She-Ra)</rdf:li>
          <rdf:li>Bow Is a Good Friend (She-Ra)</rdf:li>
          <rdf:li>F/F</rdf:li>
