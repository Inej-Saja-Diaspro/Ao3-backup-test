<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">She Ra: After The End (Final Draft)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;The Horde is gone. Prime has been destroyed. Etheria is finally free and at peace. But this is just the beginning of a new journey for Catra and Adora. Redemption is a long journey that Catra must walk, and new threats lurk in the shadows. Can they find peace despite the darkness still waiting in their past? Their mission to bring magic back to the universe seems impossible with so much left to do at home.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>BesottedShoe</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
