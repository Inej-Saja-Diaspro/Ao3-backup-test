    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Adopting Adora</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Angella and Micah pursue adoption after failing to get pregnant.  After battling to adopt their new child.  Angella realizes her new daughter needs a lot more than what she originally thought.  &lt;/p&gt;&lt;p&gt;Re-write to Autistic and Adopted.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
