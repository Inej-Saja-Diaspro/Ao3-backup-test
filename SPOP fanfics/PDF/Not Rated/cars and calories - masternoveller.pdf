    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Cars and Calories</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora is not looking for love.&lt;br&gt;She's not.&lt;/p&gt;
&lt;p&gt;And then...&lt;br&gt;Adora meets Catra, a waiter at one of the party events she's attending.&lt;br&gt;They make a connection in a surprising way.&lt;/p&gt;
&lt;p&gt;Melog comes along for the ride.&lt;br&gt;Bow and Glimmer are around too for emotional support.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
