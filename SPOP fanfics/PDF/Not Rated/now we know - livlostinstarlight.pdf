<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Now we know</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After saving the universe, proposing to your girlfriend should be a piece of cake. Spoiler alert, it's not!&lt;/p&gt;&lt;p&gt;Adora is trying to propose. Catra isn't making her job easier. Chaos insues.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>livlostinstarlight</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Not Rated</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>others mentioned - Character</rdf:li>
          <rdf:li>Marriage Proposal</rdf:li>
          <rdf:li>Idiots in Love</rdf:li>
          <rdf:li>Useless Lesbians</rdf:li>
          <rdf:li>adora is a dork</rdf:li>
          <rdf:li>Catra still loves her though</rdf:li>
          <rdf:li>I Don't Even Know</rdf:li>
          <rdf:li>How Do I Tag</rdf:li>
          <rdf:li>I am just rolling with it</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Adora is trying to propose</rdf:li>
          <rdf:li>Trying being the key word</rdf:li>
          <rdf:li>Just ask already Adora</rdf:li>
