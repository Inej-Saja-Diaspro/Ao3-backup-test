<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Bid</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora is in need of money â€“ sheâ€™s deep in debt with her mother in hospital requiring expensive treatments and medicines that she canâ€™t afford but needs to live. Her job doesnâ€™t pay well and thereâ€™s pretty much zero chance of advancement.&lt;br /&gt;So, she comes up with a plan to make a lot of money and in a short amount of time.&lt;br /&gt;Selling the only thing she really has control over â€“ her virginity.&lt;br /&gt;Itâ€™s humiliating but itâ€™s the only way she can think of without her friends going into debt with her.&lt;/p&gt;&lt;p&gt;Catra wins the bid and calls her an idiot.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Not Rated</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Adora Is a Mess (She-Ra)</rdf:li>
          <rdf:li>Catra in a suit</rdf:li>
          <rdf:li>Glimmer is a Good Friend (She-Ra)</rdf:li>
          <rdf:li>Bow Is a Good Friend (She-Ra)</rdf:li>
          <rdf:li>Magicat Catra (She-Ra)</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
