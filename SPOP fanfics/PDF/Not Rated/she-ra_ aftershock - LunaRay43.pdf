    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">She-Ra: Aftershock</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Re-write in Progress&lt;br /&gt;PREVIOUSLY TITLED SHE-RA YEAR 1!!!&lt;br /&gt;Directly following the aftermath of season 5 episode 13, follow Catra, Adora and crew as they navigate life after the war. Here come fights, games, love, angst, and trouble for the Best Friend Squad to conquer.&lt;br /&gt;Catra and Adora struggle with feelings and everything done during the war. Glimmer and Catra work together to restore Etheria, without killing each other. Bow struggles to be the therapy friend. And a deadly force waits for Adora.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>LunaRay43</rdf:li>
        </rdf:Seq>
      </dc:creator>
