<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Young</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;â€œCome with me quietly, girlie, and nobody gets hurt.â€&lt;/p&gt;
&lt;p&gt;Frosta freezes at the feeling of cold steel against her neck, screwing up her face uncomfortably at the hot breath of the words by her ear. It smells like rotten fish, and it is &lt;em&gt; gross, &lt;/em&gt; and she wants it away from her &lt;em&gt; as soon as possible &lt;/em&gt;.&lt;/p&gt;
&lt;p&gt;â€œStep away from me right now,â€ she breathes, not even looking behind her as the pair of them stood in the middle of an empty hallway, the only lighting being the pale blue glow from the lamps, â€œand &lt;em&gt; you &lt;/em&gt;wonâ€™t get hurt.â€&lt;/p&gt;
&lt;p&gt;The guy snorts, tightens his grip on her arm.&lt;/p&gt;
&lt;p&gt;â€œIâ€™d like to see you try, kiddo. Walk, &lt;em&gt; now &lt;/em&gt;.â€&lt;/p&gt;
&lt;p&gt;She doesnâ€™t look back, but if she did, he would have seen the smirk on her face.&lt;/p&gt;
&lt;p&gt;â€œWrong choice.â€&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>MashpotatoeQueen</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Not Rated</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Frosta (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Frosta is now my smol child</rdf:li>
          <rdf:li>i adore her</rdf:li>
