    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Density of Blood and Water</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;At the beginning of the end of her college career, Adora faces pressure to follow in her motherâ€™s corporate footsteps while the effects of gentrification seep into her beloved community. Through it all, Adora deals with family problems, works to maintain friendships, and falls in love.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>mickeydubs</rdf:li>
        </rdf:Seq>
      </dc:creator>
