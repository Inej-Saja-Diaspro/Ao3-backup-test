    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Teaching is Easy - Learning is Hard</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora is finally joining Bow and Glimmer as the new history teacher at the high school in Bright Moon.&lt;br /&gt;There she meets the new skateboarding math teacher who seems to have taken a liking to the blonde.&lt;br /&gt;Will they hit it off or will Catra just spend as much time as she can annoying Glimmer?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
