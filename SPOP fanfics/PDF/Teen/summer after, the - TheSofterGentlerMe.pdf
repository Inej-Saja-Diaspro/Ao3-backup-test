<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Summer After</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;It's been almost a year since Adora and Catra started their life together after they both abandoned everything they'd ever known. In that time they've both struggled, as Adora went to college and Catra traveled for work. Now, Adora is returning to the place she thinks of as home now, Camp Bright Moon, to work over the summer there. However, she's found that a long distance relationship, even with someone you love, is a hard thing to maintain and she's beginning to wonder if she can manage it.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>TheSofterGentlerMe</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Micah (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Summer Camp</rdf:li>
          <rdf:li>Fluff and Angst</rdf:li>
          <rdf:li>Angst with a Happy Ending</rdf:li>
          <rdf:li>Long-Distance Relationship</rdf:li>
          <rdf:li>Other cast members to have appearances</rdf:li>
          <rdf:li>Just not sure about calling them out yet</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Netossa/Spinnerella (She-Ra)</rdf:li>
          <rdf:li>Spinnerella (She-Ra)</rdf:li>
          <rdf:li>Netossa (She-Ra)</rdf:li>
          <rdf:li>Homophobic Language</rdf:li>
          <rdf:li>alcohol reference</rdf:li>
          <rdf:li>Named characters may not show up immediately</rdf:li>
          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Mermista (She-Ra)</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2023-07-06T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
    <rdf:Description xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">
      <xmp:MetadataDate>2026-11-01T10:45:19.390083-03:00</xmp:MetadataDate>
    </rdf:Description>
    <rdf:Description xmlns:calibre="http://calibre-ebook.com/xmp-namespace" xmlns:calibreSI="http://calibre-ebook.com/xmp-namespace-series-index" rdf:about="">
