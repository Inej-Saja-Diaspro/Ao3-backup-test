  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">She-Ra the Symbiotic</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora was normal. Sure, her adoptive mother and her best friend were being really weird lately but that was normal right? And the drug trials seemingly being covered up were normal too? And the weird parasite suddenly living inside her was nor- wait.&lt;br /&gt;Who the hell is Venom?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Lukaswritesthings</rdf:li>
        </rdf:Seq>
      </dc:creator>
