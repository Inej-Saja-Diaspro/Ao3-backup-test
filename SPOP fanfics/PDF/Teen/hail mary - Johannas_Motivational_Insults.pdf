<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Hail Mary</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora and Catra have been best friends for as long as they can remember, but things are not as rosy as they may seem. As the playoffs near in their senior football season, a series of events unveil their frustrations, shattering the facade and forcing them to reevaluate who they are, to themselves and to each other. They're on the edge of greatness, can they stay together and see things through? Or will their team and their hearts fall to defeat?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Johannas_Motivational_Insults</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - High School</rdf:li>
          <rdf:li>Alternate Universe - Football</rdf:li>
          <rdf:li>adora and catra are useless lesbian jocks</rdf:li>
          <rdf:li>lonnie's going to tear her hair out over these pining idiots</rdf:li>
          <rdf:li>Implied/Referenced Child Abuse</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)'s A+ Parenting</rdf:li>
          <rdf:li>autistic Adora</rdf:li>
          <rdf:li>adhd adora</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>adhd catra</rdf:li>
          <rdf:li>And they were yearning</rdf:li>
          <rdf:li>non-binary catra</rdf:li>
          <rdf:li>demisexual catra</rdf:li>
          <rdf:li>(those last two are only hinted at as she doesn't id as such at this point)</rdf:li>
          <rdf:li>(but they're definitely there)</rdf:li>
          <rdf:li>side sconnie</rdf:li>
          <rdf:li>past catralonnie</rdf:li>
          <rdf:li>and a smattering of other minor ships</rdf:li>
          <rdf:li>Angst and Feels</rdf:li>
          <rdf:li>(but also comedy and fun)</rdf:li>
          <rdf:li>Self-Loathing</rdf:li>
          <rdf:li>Emotional Abuse</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2021-06-17T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
    <rdf:Description xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">
      <xmp:MetadataDate>2026-11-01T10:47:34.910467-03:00</xmp:MetadataDate>
    </rdf:Description>
