    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Hero</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Prime is gone. The War is over. This is how the Peace begins.&lt;/p&gt;&lt;p&gt;But, how are the citizens of the Fright Zone coping?&lt;br /&gt;Where do they fit into the New Etheria?&lt;br /&gt;Spoilers for S5&lt;/p&gt;&lt;p&gt;A Prequel to Casting Out Shadows.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Paganaidd</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)'s A+ Parenting</rdf:li>
          <rdf:li>Fluff and Angst</rdf:li>
          <rdf:li>Emotional Hurt/Comfort</rdf:li>
          <rdf:li>The Fright Zone (She-Ra)</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Catradora is CANON</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Perfuma/Scorpia (She-Ra)</rdf:li>
          <rdf:li>Mermista/Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Bow's Fathers (She-Ra)</rdf:li>
          <rdf:li>Frosta (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Peace Accords</rdf:li>
          <rdf:li>Life in the Horde (She-Ra)</rdf:li>
          <rdf:li>Reunions</rdf:li>
          <rdf:li>Weddings</rdf:li>
          <rdf:li>Post-War</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Catra is in Love with Adora (She-Ra)</rdf:li>
          <rdf:li>Everyone Needs Therapy</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>The Horde as a Sovereign Nation</rdf:li>
          <rdf:li>War is Hell but Peace is Hard</rdf:li>
          <rdf:li>no beta we die like my faith in humanity</rdf:li>
          <rdf:li>Implied/Referenced Rape/Non-con</rdf:li>
          <rdf:li>Implied/Referenced Child Abuse</rdf:li>
