<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">We won't die here</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After a fatally botched kidnapping attempt, and an even more impressively botched teleportation attempt, Glimmer and Catra have to survive on Beast Island. Faced with the choice of cooperation or certain death they have a hard time deciding.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Bagge</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Catra/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Beast Island (She-Ra)</rdf:li>
          <rdf:li>Wilderness Survival</rdf:li>
          <rdf:li>hardship</rdf:li>
          <rdf:li>Co-dependence</rdf:li>
          <rdf:li>Depression</rdf:li>
          <rdf:li>sparks will fly</rdf:li>
          <rdf:li>Fur will fly</rdf:li>
          <rdf:li>Ties that bind</rdf:li>
          <rdf:li>Season 2</rdf:li>
          <rdf:li>It will get worse before it gets better</rdf:li>
          <rdf:li>Mutual Support</rdf:li>
          <rdf:li>survival against all odds</rdf:li>
          <rdf:li>It will all end in sparkles</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Enemies to Lovers</rdf:li>
          <rdf:li>PTSD</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
