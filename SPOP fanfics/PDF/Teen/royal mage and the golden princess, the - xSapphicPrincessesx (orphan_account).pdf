    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Royal Mage and the Golden Princess</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;"Glim, did you ever think about the day we met in the tower?" Adora asked, gazing into Glimmer's violet eyes.&lt;/p&gt;&lt;p&gt;"Yes," Glimmer replied, her thumbs rubbing small circles on Adora's hands.&lt;/p&gt;&lt;p&gt;Glimmadora Tangled AU, with some inspiration from Tangled: The Series.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
