<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Non-negotiable</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Aliens keep trying to marry Adora. Itâ€™s very annoying.&lt;/p&gt;&lt;p&gt;Or: They're intergalactic diplomats. Some things never change (but then again, some things do). &lt;/p&gt;&lt;p&gt;Or: Five times Catra thwarted Adoraâ€™s engagement and one time Adora returned the favor.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>ForsythiaRising</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Melog (She-Ra)</rdf:li>
          <rdf:li>if you don't have canonical aliens homemade is fine</rdf:li>
          <rdf:li>Future Fic</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Post-Season/Series 05</rdf:li>
          <rdf:li>Canon Compliant</rdf:li>
          <rdf:li>5+1 Things</rdf:li>
          <rdf:li>Space Hijinks</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>character work disguised as fluff</rdf:li>
          <rdf:li>Adora gets to have nice things</rdf:li>
          <rdf:li>Catra gets to have nice things</rdf:li>
          <rdf:li>yes they are STILL both orienting to that</rdf:li>
          <rdf:li>learning to be space adventurer diplomats</rdf:li>
          <rdf:li>IN SPACE!</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Humor</rdf:li>
          <rdf:li>this was supposed to be crack but it came out more</rdf:li>
          <rdf:li>Crack Treated Seriously</rdf:li>
          <rdf:li>a series of increasingly ridiculous alien engagements</rdf:li>
          <rdf:li>incredibly competent disaster girlfriends</rdf:li>
          <rdf:li>who love each other so so so much</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
