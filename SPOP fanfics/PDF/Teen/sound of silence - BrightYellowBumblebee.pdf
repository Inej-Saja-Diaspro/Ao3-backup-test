<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Sound of Silence</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora could vividly remember the last time she heard anything; it was Catraâ€™s voice calling out to her in a blaze of background noise and through a haze of pain.&lt;/p&gt;&lt;p&gt;--&lt;/p&gt;&lt;p&gt;She-ra but featuring deaf!Adora (with a She-ra caveat) and supportive!Catra&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>BrightYellowBumblebee</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>Deaf Character</rdf:li>
          <rdf:li>Canon-Typical Violence</rdf:li>
          <rdf:li>Out of Character</rdf:li>
          <rdf:li>I mean they grew up differently</rdf:li>
          <rdf:li>so it would make sense they would act differently</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Protective Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>Catra (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>everybody needs a hug</rdf:li>
          <rdf:li>Bow: that's your cue</rdf:li>
          <rdf:li>Anxiety</rdf:li>
          <rdf:li>Razz: she has her own warning</rdf:li>
          <rdf:li>Shadow Weaver: definitely has her own warning</rdf:li>
          <rdf:li>Angella: these aren't my kids but I'mma parent them all the same</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)(hinted)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Mermista (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Castaspella (She-Ra)</rdf:li>
          <rdf:li>Castaspella: I'mma here to aunt you and I brought wine</rdf:li>
          <rdf:li>Octavia: I can't think of any redeeming features</rdf:li>
          <rdf:li>Spinnerella (She-Ra)</rdf:li>
          <rdf:li>Netossa (She-Ra)</rdf:li>
          <rdf:li>SpinToss: badass and competent? Yes please</rdf:li>
          <rdf:li>Frosta (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Frosta: my other name is Toph</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
