      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">I Donâ€™t Feel Like Dancing</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Will one goofy argument about cutlery in the dish washer ruin the Allianceâ€™s night of romance and revelry at the annual Athletic Gala ?&lt;/p&gt;&lt;p&gt;(Probably, yeah.)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
