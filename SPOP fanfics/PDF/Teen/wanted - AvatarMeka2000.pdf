      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Wanted</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;During a regular visit to the Lance and Georgeâ€™s library, Catra finds out the truth of where she came from. &lt;/p&gt;&lt;p&gt;Surprise, surprise, another Catra is a princess AU.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
