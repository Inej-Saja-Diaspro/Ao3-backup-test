<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Nine Lives of Catra Applesauce Meow Meow</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Nine times Catra died and the one time SheRa reset those lives.&lt;/p&gt;&lt;p&gt;Based on the tweet from Noelle Stevenson that Catra burned through all nine lives throughout the course of SheRa and then got those lives reset after Save the Cat.&lt;/p&gt;&lt;p&gt;*Warning for suicidal ideation, mentions of child abuse and torture*&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>EmiliaGryphon</rdf:li>
        </rdf:Seq>
      </dc:creator>
