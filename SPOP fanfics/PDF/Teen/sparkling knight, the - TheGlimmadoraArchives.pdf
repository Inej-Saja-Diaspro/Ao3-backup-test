<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Sparkling Knight</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora, the Princess of Grayskull, was kept inside the castle by Shadow Weaver for years. One fateful day, her new knight, Glimmer, sneaks her out of the castle.&lt;/p&gt;&lt;p&gt;Glimmer seeks to keep Adora safe and to help protect the kingdom. Adora wants to someday bring the kingdom of Grayskull into an era of peace when she becomes queen.&lt;/p&gt;&lt;p&gt;Meanwhile, an ancient evil seeks to destroy the land.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>TheGlimmadoraArchives</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>He-Man | Adam</rdf:li>
          <rdf:li>Teela (He-Man)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Medieval</rdf:li>
          <rdf:li>Alternate Universe - Fantasy</rdf:li>
          <rdf:li>Glimadora - Freeform</rdf:li>
          <rdf:li>Glimmadora - Freeform</rdf:li>
          <rdf:li>Developing Relationship</rdf:li>
          <rdf:li>Princess Adora (She-Ra)</rdf:li>
          <rdf:li>Knight Glimmer</rdf:li>
          <rdf:li>Blood and Injury</rdf:li>
          <rdf:li>Implied/Referenced Character Death</rdf:li>
          <rdf:li>Trauma</rdf:li>
          <rdf:li>Dreams and Nightmares</rdf:li>
          <rdf:li>Adora and Catra are Siblings (She-Ra)</rdf:li>
          <rdf:li>Mythical Beings &amp; Creatures</rdf:li>
          <rdf:li>Protective Glimmer (She-Ra)</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2024-10-06T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
