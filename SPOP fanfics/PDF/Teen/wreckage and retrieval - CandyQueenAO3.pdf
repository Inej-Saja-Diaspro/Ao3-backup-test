      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Wreckage and Retrieval</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;This fiction is a Science Fiction Alternate Universe in which Catra and Adora own their own business called "Catradora Heroes for Hire" and a spaceship called SWFT-WND. &lt;/p&gt;&lt;p&gt;One day they are contacted by an alien named Hordak who requests that they aid him in a rescue mission to Beast Planet. Should they be successful, Catra and Adora will be richly rewarded! However, upon landing, truths are revealed, friendships are tested, and the morality of regicide is debated.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>CandyQueenAO3</rdf:li>
        </rdf:Seq>
      </dc:creator>
