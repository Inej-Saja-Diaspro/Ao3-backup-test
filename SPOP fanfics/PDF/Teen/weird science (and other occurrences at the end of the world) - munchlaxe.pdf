    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">weird science (and other occurrences at the end of the world)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;There is a new scientist at the Etherian Shatterdome.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>munchlaxe</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Entrapta/Hordak (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Imp (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Pacific Rim AU</rdf:li>
          <rdf:li>Alternate Universe - Pacific Rim Fusion</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Post-Traumatic Stress Disorder - PTSD</rdf:li>
          <rdf:li>Panic Attacks</rdf:li>
          <rdf:li>Kissing for science</rdf:li>
          <rdf:li>one gratuitous xiaolin showdown reference</rdf:li>
          <rdf:li>i used the f word once and you're not going to believe who says it</rdf:li>
          <rdf:li>i hate writing fight scenes but i love writing about giant robots</rdf:li>
          <rdf:li>alternating povs</rdf:li>
          <rdf:li>Hordak is in therapy; it's what he deserves</rdf:li>
          <rdf:li>canon typical age difference</rdf:li>
          <rdf:li>Original Male Character</rdf:li>
