<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">the stars, the moons, and everything in between</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Running from an inevitable fate, Adora - also known as She-Ra, Princess of Power - has enlisted in the Rebellion's efforts to displace the Glorious Imperial Army of the Horde. When her ship runs out of fuel in the most inconvenient part of the galaxy, she must rely on the kindness of an elusive stranger, a girl with daggers in her sleeves and secrets between her teeth. In the end, the two must reckon with their individual debts and destinies to help balance the universe... or not.&lt;br /&gt;**a catradora space cowboys AU&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>heartofmara</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Perfuma/Scorpia (She-Ra)</rdf:li>
          <rdf:li>Double Trouble/money</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Wrong Hordak (but he's a droid)</rdf:li>
          <rdf:li>Light Hope (She-Ra)</rdf:li>
          <rdf:li>Mara (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Double Trouble (She-Ra)</rdf:li>
          <rdf:li>MDA3 (you'll see!)</rdf:li>
          <rdf:li>the one and only catradora space cowboys AU</rdf:li>
          <rdf:li>maybe also a star wars AU if you squint</rdf:li>
          <rdf:li>Space AU</rdf:li>
