  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Several Examples of Imperfect Signage</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Five times Adora got the wrong message, and one time she got the right one.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Urist</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Minor or Background Relationship(s)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>let Glimmer say fuck</rdf:li>
          <rdf:li>Oblivious Adora (She-Ra)</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Violence</rdf:li>
          <rdf:li>Blood</rdf:li>
          <rdf:li>Cartoon Physics</rdf:li>
          <rdf:li>but for</rdf:li>
          <rdf:li>Jousting</rdf:li>
          <rdf:li>5+1 Things</rdf:li>
          <rdf:li>gratuitous feats of strength</rdf:li>
          <rdf:li>Extreme Renn Faire Nostalgia</rdf:li>
          <rdf:li>Alternate Universe - Medieval</rdf:li>
          <rdf:li>Bow Deserves a Nap</rdf:li>
          <rdf:li>Catra Deserves a Nap</rdf:li>
          <rdf:li>Glimmer is possibly Too Into This</rdf:li>
          <rdf:li>sometimes love is enabling your wife</rdf:li>
          <rdf:li>Catra's love language is being a bit of a shit</rdf:li>
          <rdf:li>Glimmer's love language is talking over you</rdf:li>
          <rdf:li>Bow's love language is fixing problems someone else caused</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Adora &amp; Bow (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Catra &amp; Glimmer (She-Ra)</rdf:li>
        </rdf:Bag>
