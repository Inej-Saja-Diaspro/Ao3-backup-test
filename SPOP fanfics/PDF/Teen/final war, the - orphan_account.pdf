<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Final War</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After a brief confrontation in the Fright Zone, Adora and Catra find themselves on Horde Prime's ship. Horde Prime threatens to destroy Etheria.&lt;/p&gt;&lt;p&gt;Adora can no longer turn into She-Ra using the broken Sword of Protection.&lt;/p&gt;&lt;p&gt;Glimmer and Adora develop feelings for each other.&lt;/p&gt;&lt;p&gt;Catra realizes that she cannot escape the consequences of her actions forever.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
