<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Last Five Years</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra and Adora are over. They have spent their lives together for five years, and now they're done.&lt;br&gt;Just where did they go wrong? Time for both of them to review.&lt;/p&gt;
&lt;p&gt;A fanfic inspired by the musical "The Last Five Years" just with less cheating (read none) and a happier ending because don't even think for a second I would actually separate these two.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>MessTrudi</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra &amp; Double Trouble (She-Ra)</rdf:li>
          <rdf:li>mentioned Scorpia/Perfuma</rdf:li>
          <rdf:li>mentioned Mermista/Sea Hawk - Relationship</rdf:li>
          <rdf:li>mentioned Netossa/Spinnerella - Relationship</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Double Trouble (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Mentioned Glimmer - Character</rdf:li>
          <rdf:li>Mentioned Bow - Character</rdf:li>
          <rdf:li>mentioned Perfuma</rdf:li>
          <rdf:li>Entrapta cameo</rdf:li>
          <rdf:li>mentioned Mermista</rdf:li>
          <rdf:li>Netossa (She-Ra)</rdf:li>
          <rdf:li>Spinnerella (She-Ra)</rdf:li>
          <rdf:li>mentioned Frosta</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Breaking Up &amp; Making Up</rdf:li>
          <rdf:li>Adora is an author</rdf:li>
          <rdf:li>Catra is a theater actor</rdf:li>
          <rdf:li>or whatever the word is</rdf:li>
          <rdf:li>google didn't help</rdf:li>
          <rdf:li>no beta we die like shadow weaver</rdf:li>
          <rdf:li>not that she is in this</rdf:li>
          <rdf:li>I mean she is</rdf:li>
          <rdf:li>she gets like two vague mentions</rdf:li>
          <rdf:li>but not named</rdf:li>
          <rdf:li>anyway my tags are chaotic i'm sorry</rdf:li>
          <rdf:li>How Do I Tag</rdf:li>
          <rdf:li>author is awkward as hell</rdf:li>
          <rdf:li>Other Additional Tags to Be Added</rdf:li>
          <rdf:li>Angst and Hurt/Comfort</rdf:li>
          <rdf:li>Happy Ending</rdf:li>
          <rdf:li>Hopeful Ending</rdf:li>
          <rdf:li>not sure which one is accurate</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>a bit of cursing</rdf:li>
          <rdf:li>I'm sure no job I'm portraying is accurate</rdf:li>
          <rdf:li>I just took what the musical gave me and didn't ask questions</rdf:li>
        </rdf:Bag>
      </dc:subject>
