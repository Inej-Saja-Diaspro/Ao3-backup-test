    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Assorted Adventures Of Etheria High</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A collection of stories that explore different characterâ€™s relationships with each other in more detail and show events that didnâ€™t fit into the main story or werenâ€™t all that relevant to the plot. All take place during and after the events of Teenage Wasteland. You will have to read that story before this one to understand whatâ€™s going on. &lt;/p&gt;&lt;p&gt;Updates every Thursday&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
