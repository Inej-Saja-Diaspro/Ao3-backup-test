<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Brightest Star</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After all of the chaos of the war, Hordak is now free. Well, from Horde Prime, that is. The princesses certainly donâ€™t think so, and they donâ€™t appear too keen on allowing him to be anytime soon.&lt;/p&gt;&lt;p&gt;Except for Entrapta. Through everything, she stays there by his side, remaining as a comforting constant amidst this new and unfamiliar life post war. And Hordak, of course, greatly enjoys her companionship.&lt;/p&gt;&lt;p&gt;...More so than he realizes, it seems.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>becki</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Entrapta/Hordak (She-Ra)</rdf:li>
          <rdf:li>Minor or Background Relationship(s)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Minor Characters</rdf:li>
          <rdf:li>Slow Burn</rdf:li>
          <rdf:li>Mutual Pining</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Feelings Realization</rdf:li>
          <rdf:li>Canon Autistic Character</rdf:li>
          <rdf:li>internalized ableism</rdf:li>
          <rdf:li>Ableism</rdf:li>
          <rdf:li>Autistic Entrapta (She-Ra)</rdf:li>
          <rdf:li>Religious Guilt</rdf:li>
          <rdf:li>hordak is bad at feelings</rdf:li>
          <rdf:li>Dorks in Love</rdf:li>
          <rdf:li>Falling In Love</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>expect lots of hordak being his usual self-loathing self</rdf:li>
          <rdf:li>and expect entrapta NOT standing for this</rdf:li>
          <rdf:li>also</rdf:li>
          <rdf:li>IN SPACE!</rdf:li>
          <rdf:li>because of course these dorks will be going to space later in this fic</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
