<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">She-Ra|He-Man: The Power of Grayskull</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora sympathizes with Man-At-Arms' obvious distress. He tugs at the corner of his graying mustache. "So the entirety of your planâ€”that is, the way you mean to save the king of Eternia and defeat an evil sorcerer with an ancient staff of untold magical powerâ€”is to go to his ship and, 'Talk him down or punch him out?'"&lt;/p&gt;&lt;p&gt;Glimmer grimaces.&lt;/p&gt;&lt;p&gt;Catra smirks.&lt;/p&gt;&lt;p&gt;Bow rubs the back of his head, then smiles. "You're not very familiar with how we do things, are you?"&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>ChapstickPenny</rdf:li>
        </rdf:Seq>
      </dc:creator>
