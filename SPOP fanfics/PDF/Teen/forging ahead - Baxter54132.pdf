      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Forging Ahead</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;The war with Horde Prime is over. The Princesses all return home to rebuild their kingdoms and Adora starts her journey to bring magic to all of Etheria.&lt;/p&gt;&lt;p&gt;Catra just wonders where she fits in to all of this. With some help from Adora, some new friends, and some old ones, she's confident she can find her way.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Baxter54132</rdf:li>
        </rdf:Seq>
      </dc:creator>
