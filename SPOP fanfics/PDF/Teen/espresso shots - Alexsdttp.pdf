          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Mermista (She-Ra)</rdf:li>
          <rdf:li>Lonnie (She-Ra)</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Fluff and Angst</rdf:li>
          <rdf:li>Implied Sexual Content</rdf:li>
          <rdf:li>Mild Smut</rdf:li>
          <rdf:li>Kissing</rdf:li>
          <rdf:li>Drunk Adora (She-Ra)</rdf:li>
          <rdf:li>Probably a ton of fluff</rdf:li>
          <rdf:li>and little angst</rdf:li>
          <rdf:li>Alternate Universe - Coffee Shops &amp; CafÃ©s</rdf:li>
