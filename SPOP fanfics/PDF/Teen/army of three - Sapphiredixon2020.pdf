          <rdf:li>Polyamory</rdf:li>
          <rdf:li>Team as Family</rdf:li>
          <rdf:li>Idiots in Love</rdf:li>
          <rdf:li>M/M</rdf:li>
          <rdf:li>Other</rdf:li>
          <rdf:li>She-Ra: Princess Of Power (1985)</rdf:li>
          <rdf:li>Imp (She-Ra)</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Lonnie represses her feelings to an unhealthy degree</rdf:li>
          <rdf:li>Foreshadowing</rdf:li>
          <rdf:li>Childhood Trauma</rdf:li>
          <rdf:li>Rogelio is a gentle soul (She-Ra)</rdf:li>
          <rdf:li>Post-War</rdf:li>
