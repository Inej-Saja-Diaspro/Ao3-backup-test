<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">come gain your merit</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;We come to grips with what is gone, so we can build something new. &lt;/p&gt;&lt;p&gt;Three stories as Adora does just that.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>womenlovingwonderwoman (The_Camel_Queen)</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Entrapta (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Angella (She-Ra)</rdf:li>
          <rdf:li>Glimmer &amp; Micah (She-Ra)</rdf:li>
          <rdf:li>Bow &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Bow &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Micah (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>adoptee trauma</rdf:li>
          <rdf:li>Minor Character Death</rdf:li>
          <rdf:li>Post-Traumatic Stress Disorder - PTSD</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Depression</rdf:li>
          <rdf:li>Anxiety</rdf:li>
          <rdf:li>Adora (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>Catra (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>bow (she-ra) needs a hug</rdf:li>
          <rdf:li>Glimmer Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Catra Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>Bow Is a Good Friend (She-Ra)</rdf:li>
          <rdf:li>Autistic Entrapta (She-Ra)</rdf:li>
          <rdf:li>Queen Catra (She-Ra)</rdf:li>
          <rdf:li>Princess Catra (She-Ra)</rdf:li>
          <rdf:li>this is a little breather while i write the next installment</rdf:li>
          <rdf:li>some of it will be happier than others</rdf:li>
          <rdf:li>but as bad as things look now it will get worse</rdf:li>
          <rdf:li>and also so much better</rdf:li>
          <rdf:li>adora is a little bit more of a reliable narrator in this</rdf:li>
          <rdf:li>but she's not the only pov</rdf:li>
          <rdf:li>POV Adora (She-Ra)</rdf:li>
          <rdf:li>pov angella</rdf:li>
          <rdf:li>i also think i gave angella a bad rap in this story so consider this her redemption arc</rdf:li>
          <rdf:li>i love her character i just wanted to critique it</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>F/F</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2021-01-31T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
