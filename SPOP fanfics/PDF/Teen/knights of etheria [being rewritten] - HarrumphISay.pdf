      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Knights of Etheria [BEING REWRITTEN]</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;(Clone Wars Narrator Voice)&lt;br /&gt;Flight from the Horde!&lt;br /&gt;The Arrival of Lady Masago and her apprentice send the wild Catra to flight, forever altering the fate of Etheria&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
