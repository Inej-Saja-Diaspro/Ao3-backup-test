<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Notice Me</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;â€œFirst name basis with the teach, huh? This class will be a cakewalk for you.â€&lt;/p&gt;&lt;p&gt;â€œDonâ€™t change the subject,â€ Adora whispered back. â€œWeâ€™ve been going to school together for like five years now, and you donâ€™t even remember me.â€ &lt;/p&gt;&lt;p&gt;Catra took a longer look at the girl. Still pretty, but further than thatâ€¦ â€œ Iâ€™m not really into the social scene.â€&lt;/p&gt;&lt;p&gt;â€œYou knew Seahawk.â€&lt;/p&gt;&lt;p&gt;â€œEverybody knows Seahawk!â€ Catra defended quietly. â€œHe set his own car on fire!â€&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>AlexandriaCornbread</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - High School</rdf:li>
          <rdf:li>AU</rdf:li>
          <rdf:li>this is kinda just me writing about my own high school experience</rdf:li>
          <rdf:li>but with a twist</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Multi</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Mermista</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Friends to Lovers</rdf:li>
          <rdf:li>Humor</rdf:li>
          <rdf:li>Romance</rdf:li>
          <rdf:li>No Angst as far as I've written</rdf:li>
          <rdf:li>Perfuma/Scorpia (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Mermista/Sea Hawk (She-Ra)</rdf:li>
