<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Rise of the Scarlet Wildcat</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra tells Adora to break-up with Pearl and it goes badly. She gets thrown out. Adora tries to search for Catra, with the assistance of friends, and is unsuccessful. One day, everything changes for the wildcat when she meets someone, dressed in a red trench-coat and fedora, that... she never expected. They have a much deeper connection than either had originally anticipated.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>lefemmerouge</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Carmen Sandiego (Cartoon 2019)</rdf:li>
          <rdf:li>Catra (She-Ra)/Carmen Sandiego | Black Sheep</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)/Pearl (Steven Universe)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Carmen Sandiego | Black Sheep</rdf:li>
