<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Worse Than the Horde</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra just wanted to find help. She wanted to be better, but when spotted by the Rebellion... Let's just say she isn't greeted with hugs and kind words.&lt;/p&gt;&lt;p&gt;Adora finds out four days later.&lt;/p&gt;&lt;p&gt;OR&lt;/p&gt;&lt;p&gt;Glimmer is in her 'dark queen' era and Adora is having absolutely none of it.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
