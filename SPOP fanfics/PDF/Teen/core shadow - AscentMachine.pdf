          <rdf:li xml:lang="x-default">Core Shadow</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Core Shadow: A dark band where light and dark meet. Catra was going to have to face the truth one day - her loyalties were splitting.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
