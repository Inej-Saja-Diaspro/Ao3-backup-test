<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10 miles away</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Separated at age 8.  Living two different lives, becoming two different people.  Then falling in love at age seventeen like it was meant to be.  All that separates us is your parents, my social worker, our friends, social standings, school, and ten miles.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
