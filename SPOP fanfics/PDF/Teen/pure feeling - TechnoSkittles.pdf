<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Pure Feeling</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A lot can happen in eight years. There's even more than can happen in just five.&lt;/p&gt;&lt;p&gt;Getting over your crush from high school would not be one of them apparently. Something that Catra is quick to discover during one incidental shopping trip on a sluggish late summer afternoon. All in one moment, she's spiraling again, memories of heartbreak, betrayal, and unconditional love hitting her with the force of a typhoon.&lt;/p&gt;&lt;p&gt;A typhoon named Mara.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>TechnoSkittles</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Razz (She-Ra)</rdf:li>
          <rdf:li>He-Man | Adam</rdf:li>
          <rdf:li>Original Characters</rdf:li>
          <rdf:li>Mara (She-Ra)</rdf:li>
          <rdf:li>the cliche family au we've all been waiting for</rdf:li>
          <rdf:li>and by that I mean I legit haven't found one and I'm APPALLED</rdf:li>
          <rdf:li>family au</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Alternate Universe - Family</rdf:li>
          <rdf:li>we're bringing in all the cliche tropes here</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Fluff and Angst</rdf:li>
          <rdf:li>still figuring out some things here and there</rdf:li>
          <rdf:li>so will add more tags and characters as I figure out where they fit into the story</rdf:li>
          <rdf:li>Mara is Adora's daughter in this AU</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Lonnie (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Alcohol</rdf:li>
          <rdf:li>Catra is Puerto Rican in this AU</rdf:li>
          <rdf:li>In fact it's safe to assume she'll be Puerto Rican in almost any AU I do</rdf:li>
          <rdf:li>unless I say otherwise</rdf:li>
          <rdf:li>Glimmer is Filipino</rdf:li>
          <rdf:li>He-Man | Adam/Glimmer (She-Ra)</rdf:li>
          <rdf:li>side relationship - Relationship</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Mermista (She-Ra)</rdf:li>
          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>slowburn</rdf:li>
          <rdf:li>Mermista/Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Frosta (She-Ra)</rdf:li>
          <rdf:li>Double Trouble (She-Ra)</rdf:li>
          <rdf:li>Light Hope (She-Ra)</rdf:li>
          <rdf:li>Rogelio (She-Ra)</rdf:li>
          <rdf:li>Kyle (She-Ra)</rdf:li>
          <rdf:li>Spinnerella (She-Ra)</rdf:li>
          <rdf:li>Netossa (She-Ra)</rdf:li>
          <rdf:li>Marlena (He-Man)</rdf:li>
          <rdf:li>Randor (He-Man)</rdf:li>
          <rdf:li>Man-At-Arms (He-Man)</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2020-12-14T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
    <rdf:Description xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">
      <xmp:MetadataDate>2026-11-01T10:46:30.443891-03:00</xmp:MetadataDate>
    </rdf:Description>
    <rdf:Description xmlns:calibre="http://calibre-ebook.com/xmp-namespace" rdf:about="">
      <calibre:timestamp>2026-10-31T21:38:09-03:00</calibre:timestamp>
      <calibre:title_sort>pure feeling</calibre:title_sort>
