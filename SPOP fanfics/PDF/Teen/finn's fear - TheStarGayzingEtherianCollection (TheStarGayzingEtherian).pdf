<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Finn's Fear</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Finn hasn't had the best life, going from one foster family to the next and always getting sent back to that horrible orphanage. Now though, little Finn has the best mothers they could ask for in Adora and Catra... but one night, something sparks those old fears up again. (Catradora, Canon, Angst/Hurt/Comfort)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>TheStarGayzingEtherianCollection (TheStarGayzingEtherian)</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Finn | Adora/Catra Child (She-Ra)</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Canon</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Future Fic</rdf:li>
          <rdf:li>Adopted Finn (She-Ra)</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Adopted Children</rdf:li>
          <rdf:li>Finn needs a hug (She-Ra)</rdf:li>
          <rdf:li>Post-War</rdf:li>
          <rdf:li>Parents Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Married Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Arguing</rdf:li>
          <rdf:li>References to He-Man and the Masters of the Universe</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Catra Has Anger Issues (She-Ra)</rdf:li>
          <rdf:li>Adora Has Anger Issues (She-Ra)</rdf:li>
          <rdf:li>Catra Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>Adora Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>Angst with a Happy Ending</rdf:li>
