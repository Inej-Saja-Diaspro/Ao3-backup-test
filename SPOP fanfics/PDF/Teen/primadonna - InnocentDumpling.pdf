<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Primadonna</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra has always dreamt of a life in the spotlight. A reality that is now hers. But then her best friend, and fellow musician, Adora steps in when their lead drummer is off on medical leave and her entire world is turned on its head. [ Catradora ]&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>InnocentDumpling</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Lonnie (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Rock Band</rdf:li>
          <rdf:li>Band Fic</rdf:li>
          <rdf:li>Idiots in Love</rdf:li>
          <rdf:li>Friends to Lovers</rdf:li>
          <rdf:li>Childhood Friends</rdf:li>
          <rdf:li>Catra is Bad at Feelings (She-Ra)</rdf:li>
          <rdf:li>Oblivious Adora (She-Ra)</rdf:li>
          <rdf:li>Denial of Feelings</rdf:li>
          <rdf:li>Love Confessions</rdf:li>
          <rdf:li>Inspired by Music</rdf:li>
          <rdf:li>Miscommunication</rdf:li>
          <rdf:li>Misunderstandings</rdf:li>
          <rdf:li>Possessive Behavior</rdf:li>
