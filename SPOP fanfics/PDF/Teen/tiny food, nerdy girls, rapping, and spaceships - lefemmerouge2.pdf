<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Tiny Food, Nerdy Girls, Rapping, and Spaceships</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Entrapta had only come to Earth as part of a mission to restore magic to the universe, a "road trip" thought up by four best friends: Adora, Catra, Bow, and Glimmer. She never expected to meet a music band which not only wielded weapons formed out of a magic barrier, but their songs strengthened that barrier as they kept demons at bay, and stopped the efforts of their master to take over the Earth's surface. Entrapta found herself drawn closer to one of the band's musicians, a rapper named Zoey, and as time went on, their friendship strengthened, as they both realized what they had in common with one another, sharing their interests and insecuritiesâ€¦&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>lefemmerouge2</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>KPop Demon Hunters (2025)</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Zoey (KPop Demon Hunters) &amp; Entrapta (She-Ra)</rdf:li>
          <rdf:li>Zoey (KPop Demon Hunters)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Crossover</rdf:li>
          <rdf:li>Crossovers &amp; Fandom Fusions</rdf:li>
          <rdf:li>Crossover Pairings</rdf:li>
          <rdf:li>tiny food</rdf:li>
          <rdf:li>Snacks &amp; Snack Food</rdf:li>
          <rdf:li>Based on an AO3 comment</rdf:li>
          <rdf:li>Spinoff</rdf:li>
          <rdf:li>Continuation</rdf:li>
          <rdf:li>One Shot</rdf:li>
          <rdf:li>Female Friendship</rdf:li>
          <rdf:li>Developing Friendships</rdf:li>
          <rdf:li>Fluff</rdf:li>
