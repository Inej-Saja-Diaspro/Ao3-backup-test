          <rdf:li>Canon Autistic Character</rdf:li>
          <rdf:li>Autism Spectrum</rdf:li>
          <rdf:li>Carbonite Freezing (Star Wars)</rdf:li>
          <rdf:li>Moral Ambiguity</rdf:li>
          <rdf:li>Mentioned Scorpia (She-Ra)</rdf:li>
