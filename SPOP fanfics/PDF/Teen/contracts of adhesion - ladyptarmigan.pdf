<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Contracts of Adhesion</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;
  &lt;i&gt;â€œI am the one who decides how the Horde will best serve,â€ Hordakâ€™s voice cuts through tense, horrified silence.&lt;/i&gt;
&lt;/p&gt;
&lt;p&gt;  &lt;i&gt;The prongs of his spear dig into Catraâ€™s neck where it pins her to a console. Adora doesnâ€™t lower her sword, but the unnatural brightness of her eyes gutters out.  Her heart feels squeezed by a fist.&lt;/i&gt;&lt;/p&gt;
&lt;p&gt;  &lt;i&gt;â€œLeave now, or your friend dies.â€&lt;/i&gt;&lt;/p&gt;
&lt;p&gt;[Catra redemption arc set to three parts]&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>ladyptarmigan</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Netossa (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra) Redemption</rdf:li>
          <rdf:li>catradora</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Catra Redemption Arc</rdf:li>
          <rdf:li>Three part series</rdf:li>
          <rdf:li>Each Part can be read Stand Alone</rdf:li>
          <rdf:li>why is hordak on etheria and what are his actual goals?</rdf:li>
          <rdf:li>what would realistically make catra leave the horde?</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>looking at that process of growth and change and healing</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
