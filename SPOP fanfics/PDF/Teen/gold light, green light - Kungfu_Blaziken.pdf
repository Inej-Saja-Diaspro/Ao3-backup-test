<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Gold Light, Green Light</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A new force enters the battle for Etheria, changing the paths of Adora and Catra forever. She has the power of Green Lantern's Light!&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Kungfu_Blaziken</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Green Lantern (Comics)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Melog (She-Ra)</rdf:li>
          <rdf:li>Ghost!Mara</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>and the rest! - Character</rdf:li>
          <rdf:li>He-Man characters</rdf:li>
          <rdf:li>Jessica Cruz</rdf:li>
          <rdf:li>Soranik Natu</rdf:li>
          <rdf:li>Various Green Lanterns</rdf:li>
          <rdf:li>GL!Adora</rdf:li>
          <rdf:li>Crack Treated Seriously</rdf:li>
          <rdf:li>Very seriously</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner's A+ Parenting</rdf:li>
          <rdf:li>(screw her)</rdf:li>
          <rdf:li>Warning: Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Adora Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>Catra Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>they get therapy</rdf:li>
          <rdf:li>Friendship</rdf:li>
          <rdf:li>Enemies to Friends to Lovers</rdf:li>
          <rdf:li>Catradora for Life!</rdf:li>
          <rdf:li>Action/Adventure</rdf:li>
          <rdf:li>Therapy Cat Melog (She-Ra)</rdf:li>
          <rdf:li>Soft Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>AKA the best kind</rdf:li>
          <rdf:li>Space Adventures!</rdf:li>
          <rdf:li>Mind Control</rdf:li>
          <rdf:li>breaking mind control - Freeform</rdf:li>
          <rdf:li>found family fluff</rdf:li>
          <rdf:li>Anxiety</rdf:li>
          <rdf:li>Depression</rdf:li>
          <rdf:li>Sheer Unbridled Joy</rdf:li>
          <rdf:li>BAMF Adora</rdf:li>
          <rdf:li>BAMF Catra</rdf:li>
          <rdf:li>OP Adora</rdf:li>
          <rdf:li>Shadow Weaver getting a verbal smackdown</rdf:li>
          <rdf:li>Horde Prime getting a giant green fist to the face</rdf:li>
          <rdf:li>DC Comics References</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018) Season 5 Spoilers</rdf:li>
          <rdf:li>after the war</rdf:li>
          <rdf:li>Creative Power Use</rdf:li>
          <rdf:li>(par for the course for Lanterns)</rdf:li>
          <rdf:li>quiet moments</rdf:li>
          <rdf:li>Crazy moments</rdf:li>
          <rdf:li>Epic Battles</rdf:li>
          <rdf:li>Epic Love</rdf:li>
          <rdf:li>And one nerd's insane idea brought to life</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Trying to rig He-Man stuff into the show's mythology</rdf:li>
