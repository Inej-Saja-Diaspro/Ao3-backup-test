          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>season 4</rdf:li>
          <rdf:li>Enemies to Lovers</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Revenge</rdf:li>
          <rdf:li>Drama</rdf:li>
          <rdf:li>queen glimmer</rdf:li>
          <rdf:li>Queen Catra</rdf:li>
          <rdf:li>Evil Glimmer</rdf:li>
          <rdf:li>Evil Catra</rdf:li>
          <rdf:li>Evil Queen Glimmer</rdf:li>
          <rdf:li>Evil Queen Catra</rdf:li>
          <rdf:li>Machiavellian Glimmer</rdf:li>
          <rdf:li>Machiavellian Catra</rdf:li>
