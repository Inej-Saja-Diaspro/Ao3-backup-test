<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Catra and Glimmer - Queens of the Horde</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Betrayed, cast out and pissed off, Glimmer and Catra set out together to reclaim their lost queenhoods and get revenge on those who wronged them.&lt;/p&gt;&lt;p&gt;The story is set in late Season 4 when the stakes are up in the sky and both Catra and Glimmer are indulging their very darkest sides. In this version, instead of helping each other see the error of their ways, they will enable each other. Look out world!&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Bagge</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
