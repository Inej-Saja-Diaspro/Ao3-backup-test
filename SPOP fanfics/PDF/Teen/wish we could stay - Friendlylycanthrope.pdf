<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Wish We Could Stay</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;The Immigration brought the Horde to their knees. The Rebellion is one good victory away from ending the war for good. Knowing this, Hordak is getting desperate, which makes him even more dangerous.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Friendlylycanthrope</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora</rdf:li>
          <rdf:li>Catra</rdf:li>
          <rdf:li>Glimmer</rdf:li>
          <rdf:li>Bow</rdf:li>
          <rdf:li>Swift Wind</rdf:li>
          <rdf:li>Hordak</rdf:li>
          <rdf:li>Scorpia</rdf:li>
          <rdf:li>Entrapta</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>the portal event but different</rdf:li>
