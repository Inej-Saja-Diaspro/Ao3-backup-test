<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Origin of Sin</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Horde Prime looms over Etheria. Entrapta is back with the princesses at Bright Moon, trying to move on from her past with Hordak. As what remains of the Rebellion face the new Horde threat, the Princess of Dryl's role in the story is yet to be fully revealed.&lt;/p&gt;&lt;p&gt;Continuing on from my 'Addendum' series, this is an Entrapta and Hordak-focused alternate take on Season 5.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Solitude_Rising</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
