    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Kissing You</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;It's Halloween and the Best Friend Squad is getting ready for the big, annual party at Mermista's house.&lt;br /&gt;They're also excited to finally meet their friend Perfuma's new girlfriend.&lt;/p&gt;&lt;p&gt;The Super Pal Trio is also attending the party so Scorpia can introduce her besties to her girlfriend Perfuma and a few of Perfuma's friends.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
