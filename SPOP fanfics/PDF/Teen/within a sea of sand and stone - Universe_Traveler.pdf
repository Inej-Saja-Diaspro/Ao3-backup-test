<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Within a sea of Sand and Stone</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;The trio falls into a set of caverns and must navigate their way out.&lt;/p&gt;&lt;p&gt;Adora discovers relaxation can be a temptation,&lt;br /&gt;Bow finds out boredom leads to chaos,&lt;br /&gt;and Glimmer... Glimmer just does not have a good time.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Universe_Traveler</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Glimmer (She-Ra)</rdf:li>
          <rdf:li>implied Glimmdora</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>mentioned Huntara (She-Ra)</rdf:li>
          <rdf:li>Spiders</rdf:li>
          <rdf:li>Giant Spiders</rdf:li>
          <rdf:li>Desert</rdf:li>
          <rdf:li>Crimson Waste (She-Ra)</rdf:li>
          <rdf:li>im bad at romance</rdf:li>
          <rdf:li>i tried.</rdf:li>
          <rdf:li>Adora is a Dork (She-Ra)</rdf:li>
          <rdf:li>Bow Is a Good Friend (She-Ra)</rdf:li>
          <rdf:li>Glimmer Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Glimmer is not having a good time</rdf:li>
          <rdf:li>Adora doesn't know how to relax</rdf:li>
          <rdf:li>Swearing</rdf:li>
          <rdf:li>Glimmer deserves to swear</rdf:li>
          <rdf:li>Three POVS</rdf:li>
          <rdf:li>each chapter is a different pov and what they discovered in their tunnel adventure</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow (She-Ra)</rdf:li>
        </rdf:Bag>
