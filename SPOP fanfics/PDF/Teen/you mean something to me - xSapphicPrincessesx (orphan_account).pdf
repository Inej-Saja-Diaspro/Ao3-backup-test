    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">You Mean Something to Me</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;What if Adora gets beamed onto Horde Prime's ship instead of Glimmer?&lt;/p&gt;&lt;p&gt;How far will Glimmer go to save Adora? Will they make it up to each other?&lt;/p&gt;&lt;p&gt;When Catra realizes that her actions affect others, will she own up to what she did?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
