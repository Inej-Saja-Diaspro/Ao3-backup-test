<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Day The Sun Vanished</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;It was dark when Adora woke up.&lt;/p&gt;&lt;p&gt;That didnâ€™t mean much â€” Adora woke up at five a.m. or noon, and nowhere in between. She assumed it was five a.m. when she opened her eyes, at least until she reached for her phone and saw that it was twelve-thirty in the afternoon.&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;  &lt;em&gt;What?&lt;/em&gt;&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;OR&lt;/p&gt;&lt;p&gt;The entire world has gone dark, and all anyone can do now is try to survive.&lt;/p&gt;&lt;p&gt;OR&lt;/p&gt;&lt;p&gt;End of the world AU based on &lt;a href="https://twitter.com/TheSunVanished?ref_src=twsrc%5Egoogle%7Ctwcamp%5Eserp%7Ctwgr%5Eauthor" rel="nofollow"&gt;TheSunVanished on Twitter.&lt;/a&gt;&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>catrasredemption (dimensionhoppingrose)</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
