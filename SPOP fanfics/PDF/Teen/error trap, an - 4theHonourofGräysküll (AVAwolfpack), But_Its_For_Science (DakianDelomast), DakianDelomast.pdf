          <rdf:li>Gen</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Entrapta-centric (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra) Fixes Everything</rdf:li>
          <rdf:li>Entrapta (She-Ra) Learns How to Friend</rdf:li>
