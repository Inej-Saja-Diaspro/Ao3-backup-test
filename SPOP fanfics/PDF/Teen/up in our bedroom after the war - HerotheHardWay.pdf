<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Up in our bedroom after the war</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;It's been five weeks since Catra woke up alone, the bed gone cold beside her. It's been five weeks since she started this quest to find Adora and bring her home, and there's only one place she hasn't looked: Beast Island. When you've been the golden girl your entire life, trained and fought and bled for a war that is now over, what is left of you after?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>HerotheHardWay</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Angst with a Happy Ending</rdf:li>
          <rdf:li>Adora (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>Adora working through her trauma and her hero complex</rdf:li>
          <rdf:li>and her need to be Useful</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>That catharsis tho</rdf:li>
          <rdf:li>Catra just wants to bring Adora home</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>AU where the Rebellion wins but Adora never gets She-Ra back</rdf:li>
          <rdf:li>And everyone has their happy ending but Adora never dealt with her TRAUMA</rdf:li>
          <rdf:li>Canon Lesbian Relationship</rdf:li>
          <rdf:li>written as a speculative ending to the show before s5 came out</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2020-05-07T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
