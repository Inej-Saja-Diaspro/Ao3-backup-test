        <rdf:Alt>
          <rdf:li xml:lang="x-default">Etherian Mall</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A series of interconnected one-shots following the She-Ra cast in the hell that is retail work. Customer Service is a stressful, thankless job. At least hey can vent about it to each other.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
