<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Not All Heroes Wear Capes</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Deep in the Whispering Woods, centuries ago, a sword was damaged. And a spirit began to slip through the cracks.&lt;/p&gt;&lt;p&gt;It wasnâ€™t free, not quite. Still tied to the prison they created.&lt;/p&gt;&lt;p&gt;The two who would make history came to the world. It knew which one she wanted. But it had a choice now.&lt;/p&gt;&lt;p&gt;So it made one.&lt;/p&gt;&lt;p&gt;(Abandoned Cuz lack of motivation and also I canâ€™t write romance :P)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>TheTokenAro</rdf:li>
        </rdf:Seq>
      </dc:creator>
