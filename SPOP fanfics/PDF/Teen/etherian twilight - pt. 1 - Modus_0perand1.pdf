<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Etherian Twilight - Pt. 1</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;It has been many years since Great Leader Mara's takeover of Etheria from the First Ones, supported by her regime, the New Etheria Army. Things have changed, but for the better, or the worse?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Modus_0perand1</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Brigador (Video Game)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Kyle (She-Ra)</rdf:li>
          <rdf:li>Lonnie (She-Ra)</rdf:li>
          <rdf:li>Rogelio (She-Ra)</rdf:li>
          <rdf:li>Mecha</rdf:li>
          <rdf:li>Eventual Romance</rdf:li>
          <rdf:li>Angst and Drama</rdf:li>
          <rdf:li>Lesbian Character</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>War</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Catra is in Love with Adora (She-Ra)</rdf:li>
          <rdf:li>Trans Catra (She-Ra)</rdf:li>
          <rdf:li>Catra Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>Catra is Bad at Feelings (She-Ra)</rdf:li>
          <rdf:li>Adorable Adora (She-Ra)</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
