<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Catra's Redemption</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra has a change of heart after Scorpia leaves. She decides to disband the Horde, starting with the cadets. While doing so, she receives a message from Horde Prime which only assures her sheâ€™s making the right choice. This leads to a full redemption arc where Queen Angella is saved, Despara appears, the Horde joins the Rebellion, and Catra has her own space adventure.&lt;/p&gt;&lt;p&gt;OR &lt;/p&gt;&lt;p&gt;"Hello? Who is this?" Catra gasped. For a second all of her pain melted away. She knew that voice. It was the one that had been circling in her mind the most since she had been released from Horde Prime's control. This time she knew the name of the person who spoke â€“ Adora.&lt;/p&gt;&lt;p&gt;"Hey Adora."&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>commander_lioness</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Octavia (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra) Redemption</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Warning: Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Kyle/Lonnie/Rogelio (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Double Trouble (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Micah (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
