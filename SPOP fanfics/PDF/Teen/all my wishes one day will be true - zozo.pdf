      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">all my wishes one day will be true</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Bow and Glimmer and Mermista and Sea Hawk go on a double date.&lt;/p&gt;</rdf:li>
