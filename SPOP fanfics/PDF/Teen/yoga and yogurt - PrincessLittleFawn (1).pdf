    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Yoga and Yogurt</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra tends to shut the world out and closes her eyes to the beautiful things around her. She gets a new job at yoga studio and she can't shut her eyes to a beautiful blonde who changes everything.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>PrincessLittleFawn</rdf:li>
        </rdf:Seq>
      </dc:creator>
