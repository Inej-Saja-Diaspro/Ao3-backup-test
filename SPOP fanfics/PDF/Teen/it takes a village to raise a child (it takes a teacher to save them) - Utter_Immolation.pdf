    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">It Takes a Village to Raise a Child (It Takes a Teacher to Save Them)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;When Lance is captured by the Horde, he is offered the opportunity to work off his "crimes" by teaching reading and writing to two dozen young Horde cadets.&lt;/p&gt;&lt;p&gt;Or&lt;/p&gt;&lt;p&gt;The Teacher!Lance AU&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Utter_Immolation</rdf:li>
        </rdf:Seq>
      </dc:creator>
