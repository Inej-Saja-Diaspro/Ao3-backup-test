<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Next Stop, Please!</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Glimmer is a licensed and certified transporter for living goods and large loads, AKA a magical trucker without the truck. And unfortunately for her, Catra is about to make that a problem.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Nny11</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Catra/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Castaspella (She-Ra)</rdf:li>
          <rdf:li>Micah (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Modern with Magic</rdf:li>
          <rdf:li>Trucker!Glimmer AU (She-Ra)</rdf:li>
          <rdf:li>Catra has a magic allergy AS PER CANON FIGHT ME (She-Ra)</rdf:li>
          <rdf:li>Magical Realism</rdf:li>
          <rdf:li>Meet-Cute</rdf:li>
          <rdf:li>Vomiting</rdf:li>
          <rdf:li>World Travel</rdf:li>
          <rdf:li>Abandoned Work - Unfinished and Discontinued</rdf:li>
          <rdf:li>Glimmer is a hot mess (She-Ra)</rdf:li>
          <rdf:li>Catra is a hotter mess (She-Ra)</rdf:li>
          <rdf:li>Micah means well (She-Ra)</rdf:li>
          <rdf:li>Catra doesn't know how to flirt (She-Ra)</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
