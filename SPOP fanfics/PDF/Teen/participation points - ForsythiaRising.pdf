<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Participation Points</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra makes a variety of dramatic entrances, Glimmer fields a variety of dramatic interruptions, Bowâ€™s kind of a big deal, and Adora consistently fails to match expectations. &lt;/p&gt;&lt;p&gt;Or: theyâ€™re intergalactic celebrities. Eventually. &lt;/p&gt;&lt;p&gt;Or: five conferences the Best Friends Squad presented at and one they attended, in reverse chronological order.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>ForsythiaRising</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Huntara (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>if you don't have canonical aliens homemade is fine</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Post-Season/Series 05</rdf:li>
          <rdf:li>Canon Compliant</rdf:li>
          <rdf:li>5+1 Things</rdf:li>
          <rdf:li>POV Outsider</rdf:li>
          <rdf:li>SO much pov outsider</rdf:li>
          <rdf:li>IN SPACE!</rdf:li>
          <rdf:li>glimmer is a badass</rdf:li>
          <rdf:li>catra gets a staff</rdf:li>
          <rdf:li>bow's family loves him but that doesn't mean they understand him</rdf:li>
          <rdf:li>adora fights her girlfriend for educational reasons</rdf:li>
          <rdf:li>Reverse Chronological Order</rdf:li>
          <rdf:li>is it non-linear storytelling if it's linearly backwards?</rdf:li>
