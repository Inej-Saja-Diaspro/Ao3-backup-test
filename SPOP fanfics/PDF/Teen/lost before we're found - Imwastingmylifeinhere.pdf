<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Lost before we're found</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra, deemed "useless" by Hordak, is shipped off to Beast Island. After managing to escape, she finds something she never thought she'd have. A place of her own. A proper home. A mother.&lt;br /&gt;Oh, and apparently she's a princess. Well, isn't that ironic.&lt;br /&gt;.&lt;br /&gt;Adora, having learned of Catra's banishment, is determined to get her friend back. Whatever that takes.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Imwastingmylifeinhere</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Original Characters</rdf:li>
          <rdf:li>Catra (She-Ra) Redemption</rdf:li>
          <rdf:li>Catra (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>Catra is a princess</rdf:li>
          <rdf:li>If i have to give Catra a mother figure on my own i'll do it</rdf:li>
          <rdf:li>Slow Burn</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Family Feels</rdf:li>
          <rdf:li>Family Fluff</rdf:li>
          <rdf:li>a fix it fic after season three I guess</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Mutual Pining</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2020-07-10T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
