<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Twist</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;
  &lt;i&gt;â€œWhy do you think Aunt Castaâ€™s so obsessed with knitting? They have all this crap everywhere; knitting needles and crochet hooks and spindles and bins of embroidery thread and looms andâ€”â€&lt;/i&gt;
&lt;/p&gt;&lt;p&gt;
  &lt;i&gt;â€œNot a fan?â€ Micah asks, tamping down on a sting of disappointment when his daughter shakes her head. â€œI wouldnâ€™t be so quick to dismiss it. Why, some of the finest sorcerers have been named after these arts. Obviously, youâ€™d knowâ€”â€œ &lt;/i&gt;
&lt;/p&gt;&lt;p&gt;
  &lt;i&gt;He stops abruptly, catching his own words with a grimace. Adora has gone tense, her hand frozen where it rests on the bulbous end of a spindle. Catra, still down the hall with studied disinterest, has gone even tenser. &lt;/i&gt;
&lt;/p&gt;&lt;p&gt;â€”&lt;/p&gt;&lt;p&gt;The Best Friends Squad &amp;amp; fiber art.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>ForsythiaRising</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
