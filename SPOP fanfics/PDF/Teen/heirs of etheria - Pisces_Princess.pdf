<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Heirs of Etheria</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Three years after the death of her mom, Shiri is spiraling out of control. Her life has become a blur of clubbing, drinking, and sex to suppress her powers and her grief as she has become involved with a notorious gang leader. &lt;/p&gt;&lt;p&gt;Finn doesn't want to be like their family. They wants to travel the universe, no attachments and no worries, not since losing his long-standing crush, Shiri. &lt;/p&gt;&lt;p&gt;Fate has them reunite at a club years after they lost saw each other. Will they allow love back into their lives after losing so much? It seems there are forces stronger than them at play.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Pisces_Princess</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Shiri/Finn</rdf:li>
          <rdf:li>Shiri/Alejandro</rdf:li>
          <rdf:li>Zimri/Marmoris</rdf:li>
          <rdf:li>Lexie/Calliope</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Mermista/Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Perfuma/Scorpia (She-Ra)</rdf:li>
          <rdf:li>Entrapta/Hordak (She-Ra)</rdf:li>
          <rdf:li>Netossa/Spinnerella (She-Ra)</rdf:li>
          <rdf:li>Musa/Ronen</rdf:li>
          <rdf:li>Haevyn/Circe</rdf:li>
          <rdf:li>Brio/Callista</rdf:li>
          <rdf:li>Shiri</rdf:li>
          <rdf:li>Finn | Adora/Catra Child (She-Ra)</rdf:li>
          <rdf:li>Zimri</rdf:li>
          <rdf:li>Marmoris</rdf:li>
          <rdf:li>Halina</rdf:li>
          <rdf:li>Nicaise</rdf:li>
          <rdf:li>Shimmer</rdf:li>
          <rdf:li>Archer</rdf:li>
