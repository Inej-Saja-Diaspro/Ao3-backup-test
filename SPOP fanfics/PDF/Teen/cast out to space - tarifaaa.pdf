    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">cast out to space</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora consensually (and regretfully) decides to do magic mushrooms and comes to some realizations. Catra comes to the rescue.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>tarifaaa</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Self-Harm</rdf:li>
          <rdf:li>Implied/Referenced Child Abuse</rdf:li>
          <rdf:li>Warning: Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Drugs</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Emotional Hurt/Comfort</rdf:li>
          <rdf:li>Fluff and Angst</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Catra is in Love with Adora (She-Ra)</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Catra Acts Like a Cat (She-Ra)</rdf:li>
          <rdf:li>Past Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Adora Needs Therapy (She-Ra)</rdf:li>
        </rdf:Bag>
