<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Tale as old as time</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;
  &lt;em&gt;â€œI wonâ€™t be back until the seasons change twice, at least. Maybe longer. We wonâ€™t see each other for a while.â€ &lt;/em&gt;
&lt;/p&gt;&lt;p&gt;  &lt;em&gt;â€œPromise you wonâ€™t forget about me?â€ &lt;/em&gt;&lt;/p&gt;&lt;p&gt;  &lt;em&gt;She-Ra smiled. â€œI promise.â€&lt;/em&gt;&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;Princess Catra's life has been tainted with tragedy since she was a child. Her parents were murdered, the woman who was put in charge of her kigdom despises her, and she can't trust anyone inside her own castle. While running away from it, however, she makes a friend, one who will stay by her side for most of her life. But it looks like the girl who dreams of being a knight has some secrets of her own.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>dragonesdepapel</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Medieval</rdf:li>
          <rdf:li>Childhood Friends</rdf:li>
          <rdf:li>Friends to Lovers</rdf:li>
