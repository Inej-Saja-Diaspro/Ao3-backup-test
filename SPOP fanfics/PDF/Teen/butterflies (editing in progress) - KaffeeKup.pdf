<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Butterflies (editing in progress)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;How far will Adora go to save Catra from Prime?&lt;/p&gt;&lt;p&gt;She left Catra behind once before - sheâ€™s not making that mistake again.&lt;br /&gt;A long time ago they made a wish together, to care of the other and...Adora's going to make sure of that.&lt;br /&gt;A wish for a life together, away from war and pain. The happy ending they've always deserved.&lt;br /&gt;Adora'll do whatever it takes-&lt;/p&gt;&lt;p&gt;To Save the Cat. No matter the cost.&lt;/p&gt;&lt;p&gt;A reimagining of S5 E5&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>KaffeeKup</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
