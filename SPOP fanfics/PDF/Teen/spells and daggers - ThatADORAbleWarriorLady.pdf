    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Spells and Daggers</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora is a hunter. She protects people from supernatural monsters.&lt;/p&gt;&lt;p&gt;Glimmer is a witch who comes from a lineage of powerful spellcasters.&lt;/p&gt;&lt;p&gt;Once their paths meet, they may work together to bring down the Horde clan.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
