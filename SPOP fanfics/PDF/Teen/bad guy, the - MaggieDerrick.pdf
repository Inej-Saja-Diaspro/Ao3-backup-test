<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Bad Guy</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A terrible decision earns Catra an even worse punishment. Left to suffer the consequences, Catra finds herself facing one burning question: do you get to have a happy ending when you're the bad guy?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
