<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Heir Apparent</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Capella, daughter of Bow and Glimmer, has been protesting treatment of clones on Etheria. After a protest turned ugly, she's now more determined than ever to make sure that things turn out right for them. She has allies but she also has enemies she's not even aware of yet. But they're aware of her and they've been planning and acting in the shadows for longer than almost anyone knows. Will she find out soon enough?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>TheSofterGentlerMe</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
