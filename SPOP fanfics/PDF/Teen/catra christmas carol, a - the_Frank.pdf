<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A Catra Christmas Carol</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra D'riluth is cold, egoistic, mean and cares only about herself and her career.&lt;/p&gt;&lt;p&gt;But a late night meeting with an old acquaintance might change her mind.... and her ways...&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;Bah. Humbug.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>the_Frank</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
