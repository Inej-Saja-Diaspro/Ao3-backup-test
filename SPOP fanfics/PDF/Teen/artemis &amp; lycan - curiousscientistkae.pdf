<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Artemis &amp;amp; Lycan</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Glimmer is a hunter-the protector of Brightmoon and all those who live there. After the death of her mother, she has taken up this role. Adora is a werewolf, bitten as a child and unable to control the monster inside of her. One faithful day, their paths converge. Glimmer seeks to find her mother's killer. Adora seeks to know about the truth of her family. Will either find their answers as unbeknownst to them, shadows lurk all around and danger is brewing.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>curiousscientistkae</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Werewolves</rdf:li>
          <rdf:li>Were-Creatures</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Developing Relationship</rdf:li>
