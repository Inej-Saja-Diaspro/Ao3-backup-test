<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Friendly Neighborhood Spider... Cat ?</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;"They were wearing their usual green cargo jacket over a high collar shirt that was tucked in a black pair of pants slightly too large. The sun was still showing, at least one positive thing, they thought as they readjusted the now useless glasses on their way to the bus stop. Despite their hand being covered by mittens, they could feel still feel them get numb under the cold. This was gonna be a tiring day..."&lt;/p&gt;&lt;p&gt;Or&lt;/p&gt;&lt;p&gt;What to do when you're an awkward teenager having to deal with high-school, gay crushes and the harshness of life.&lt;br /&gt;Oh, and a giant guy in rhino costume trying to kill you.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>TheRedFool</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
