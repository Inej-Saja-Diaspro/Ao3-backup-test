          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Spider-Man - All Media Types</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Razz (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Tung Lashor</rdf:li>
          <rdf:li>Rhino (Marvel)</rdf:li>
          <rdf:li>Tags Are Hard</rdf:li>
          <rdf:li>Catra Is a Mess (She-Ra)</rdf:li>
          <rdf:li>Girl's going throught it</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Not Actually Graphic Violence</rdf:li>
          <rdf:li>Just a bit rough...</rdf:li>
          <rdf:li>not much catradora</rdf:li>
          <rdf:li>Lesbian Disaster Adora (She-Ra)</rdf:li>
          <rdf:li>Lesbian Disaster Catra (She-Ra)</rdf:li>
          <rdf:li>Catra-centric (She-Ra)</rdf:li>
          <rdf:li>Trans Catra (She-Ra)</rdf:li>
          <rdf:li>Catra is Spider-Man</rdf:li>
          <rdf:li>Alternate Universe - Superheroes/Superpowers</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
