      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Entrapta's Surprise Kissing Experiment, Glimmer's Shocking Response, Bow's Blush, Adora's Bewilderment, Catra's Laughter, and Robots</rdf:li>
