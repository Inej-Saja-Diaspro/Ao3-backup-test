<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">It's Raining Dogs</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;AU based off of Simon vs the homo sapiens agenda. &lt;/p&gt;&lt;p&gt;Adora Grayskull logs onto social media to see an interesting post. &lt;/p&gt;&lt;p&gt;Sometimes life feels like a ferris wheel, one time I'm on top of the world and other times I'm at rock bottom. Truth is, my life isn't all that bad. It's pretty great actually. To anyone, I'm just a normal girl going to this school. I just have one huge secret; no one knows I'm gay. &lt;/p&gt;&lt;p&gt;- Rain.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
