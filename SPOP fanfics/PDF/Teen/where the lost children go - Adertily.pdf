<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Where The Lost Children Go</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;In which the war orphans adopt a war orphan.&lt;/p&gt;&lt;p&gt;Catra and Adora stumble across a group of scrappy youngsters, including Finn, living alone in the Crimson Waste. They offer to take them to the children's home Scorpia reformed from the old Horde barracks. But by the time Darla makes the trip, they find thereâ€™s a little someone whoâ€™s snuggled into the deepest, most treacherous crevices of their hearts. And they canâ€™t make themselves let go.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Adertily</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Finn</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>the others in passing</rdf:li>
          <rdf:li>Found Family</rdf:li>
          <rdf:li>Adoption</rdf:li>
          <rdf:li>Kid Fic</rdf:li>
          <rdf:li>Domestic Fluff</rdf:li>
          <rdf:li>Domestic</rdf:li>
          <rdf:li>catradora</rdf:li>
          <rdf:li>Future Fic</rdf:li>
          <rdf:li>Catradora as parents</rdf:li>
          <rdf:li>Implied Sexual Content</rdf:li>
          <rdf:li>but like its very very mild and only a sentence or two</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Childhood Trauma</rdf:li>
          <rdf:li>Swearing</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Just a spoon of angst... whops</rdf:li>
          <rdf:li>Panic Attacks</rdf:li>
          <rdf:li>Finn | Adora/Catra Child (She-Ra)</rdf:li>
