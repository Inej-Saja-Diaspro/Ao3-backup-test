    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Catra writes a fanfic.</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra is outed as a pegasister, a.k.a a fan of the cartoon Equestria Girls. &lt;/p&gt;&lt;p&gt;This leads to a discussion about fanfiction in the BFS, things get emotional and heated and... The title might be a hint. Better read to find out!&lt;/p&gt;&lt;p&gt;Everyone (except Maramom who is 39 and Bow who's 16) is human and 17 years old.&lt;br /&gt;Â &lt;/p&gt;&lt;p&gt;.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>the_Frank</rdf:li>
        </rdf:Seq>
      </dc:creator>
