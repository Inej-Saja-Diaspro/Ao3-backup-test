      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Hand of an Angel, Tears of the Lost</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Grief is a powerful anchor.&lt;/p&gt;&lt;p&gt;Angella knows it well.&lt;/p&gt;&lt;p&gt;Catra stops running at last.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
