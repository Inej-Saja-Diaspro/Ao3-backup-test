<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Assassin Collection</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Glimmer is keeping the assassins that were sent to kill her, they're hers now. The royal chefs are making them breakfast, they are a family by choice although some might have blood family to go back to it's kinda nebulous and likely not so because Horde Prime killed them but I swear this is a happy and funny fic. I swear!&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Nny11</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Angella &amp; Glimmer &amp; Micah (She-Ra)</rdf:li>
          <rdf:li>Bow &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow (She-Ra)</rdf:li>
          <rdf:li>Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Glimmer &amp; Mermista (She-Ra)</rdf:li>
          <rdf:li>Glimmer &amp; Perfuma (She-Ra)</rdf:li>
          <rdf:li>Entrapta &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Glimmer &amp; Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>The whole princess alliance tbh (She-Ra)</rdf:li>
          <rdf:li>Abandoned Work - Unfinished and Discontinued</rdf:li>
          <rdf:li>Alternate Universe</rdf:li>
          <rdf:li>Alternate Universe Canon Divergent (but like majorly so)</rdf:li>
          <rdf:li>Alternate Universe - Assassins &amp; Hitmen</rdf:li>
          <rdf:li>Horde Prime is defanged and depowered</rdf:li>
          <rdf:li>Humor</rdf:li>
          <rdf:li>Crack Treated Seriously</rdf:li>
          <rdf:li>Horde Prime Chokes on a Bagel (She-Ra)</rdf:li>
          <rdf:li>Happy Ending</rdf:li>
          <rdf:li>Silly</rdf:li>
          <rdf:li>Everyone tries to kill Glimmer and fails for various reasons</rdf:li>
          <rdf:li>Brightmoon just likes collecting assassins into the family</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
        </rdf:Bag>
      </dc:subject>
