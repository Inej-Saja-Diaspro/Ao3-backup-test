<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Out of Love and Desperation</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora masters the starlight.&lt;/p&gt;&lt;p&gt;Catra gains the favor of Hordak.&lt;/p&gt;&lt;p&gt;The war begins in earnest.&lt;/p&gt;&lt;p&gt;It's going to be a near thing.&lt;/p&gt;&lt;hr /&gt;&lt;p&gt;
  &lt;em&gt;We do not hurt those we hold dear out of malice, butâ€”&lt;/em&gt;
&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
