      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">We Can Do Good and That Must Be Enough</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;The Horde descends from a broken sky.&lt;/p&gt;&lt;p&gt;The resistance rises from the artificial underworld.&lt;/p&gt;&lt;p&gt;All worlds hang in the balance.&lt;/p&gt;&lt;p&gt;Two girls carry the fate of the universe.&lt;/p&gt;&lt;hr /&gt;&lt;p&gt;
  &lt;em&gt;The labors of reparation will never undo tragedy, butâ€”&lt;/em&gt;
&lt;/p&gt;</rdf:li>
