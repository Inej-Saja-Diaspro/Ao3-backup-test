<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Couple that Slays Together (Stays Together)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora and Catra explore strange new worlds, meet weird new aliens and go on badass adventures a year after the show ends. Meanwhile, they are both still figuring out who they are and how to ask for what they want. Because they may be badass space diplomat/warrior/adventurers, but they are also 22.&lt;/p&gt;&lt;p&gt;I promise there will be a space dragon.&lt;/p&gt;&lt;p&gt;Starts space opera and then shifts into being a gay AF Conan homage. Basically the perfect fic if you are part of the converging sliver in the Venn Diagram of fandoms for She Ra and 80's US Power Metal.&lt;/p&gt;&lt;p&gt;Note: this fic is my version of teen and up, so a lot of swearing, sex and violence both happen and are discussed but not explicitly described, and characters get drunk or high. Overall violence is somewhat more than canon (there is blood, and explicit mentions of people dying).&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Todteufelritter</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Entrapta/Hordak (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Original Characters</rdf:li>
          <rdf:li>Space Opera</rdf:li>
          <rdf:li>Space Pirates</rdf:li>
          <rdf:li>Drinking</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Conan Shit</rdf:li>
          <rdf:li>Star Wars Cantina Vibes</rdf:li>
