  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Sick of Losing Soulmates</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;[for Glimbow Week 2020 countdown prompt: Soulmate AU]&lt;/p&gt;&lt;p&gt;The soulmate AU where Bow and Glimmer have dreams about another life where they loved someone they canâ€™t even remember. Until Adora invites/Catra forces them to participate in a social experiment where they have to kiss a stranger. Except... why did it feel like they knew each other from somewhere?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>caramelaire</rdf:li>
        </rdf:Seq>
      </dc:creator>
