<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">the blood in your mouth</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;"Itâ€™s funny," Horde Prime says, humourlessly, â€œhow love truly is the common weakness across the galaxies. Whatâ€™s her name?â€&lt;/p&gt;&lt;p&gt;Catra scowls, unable to keep her mask on anymore. â€œLeave her alone.â€&lt;/p&gt;&lt;p&gt;â€œI have only the best of intentions with my allies, child.â€ His lips slowly curl up. â€œWhatâ€™s her name?â€ He asks again, voice less friendly.&lt;/p&gt;&lt;p&gt;Catra breathes in and out, in and out. She lets her face go blank again. â€œAdora. But sheâ€™s not myãƒ¼â€&lt;/p&gt;&lt;p&gt;â€œSo thatâ€™s the mighty She-Ra.â€ He says. He starts to pace around, arms behind him.&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;*&lt;/p&gt;&lt;p&gt;in which love actually is the strongest thing across the galaxies&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>artemiswords</rdf:li>
        </rdf:Seq>
      </dc:creator>
