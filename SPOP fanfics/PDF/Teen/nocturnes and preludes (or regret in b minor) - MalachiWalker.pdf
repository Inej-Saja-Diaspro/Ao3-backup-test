<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Nocturnes and Preludes (Or Regret in B Minor)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Fresh off a six month tour with her band, up-and-coming rock star Catra Leandros wakes up from yet another nightmare in a lifetime full of them and tries to at least make some music out of the lemons her psyche keeps throwing at her. But the phantoms of a life she never lived, a mistake she never made, and the ghost of the girl she walked away from ten years earlier are set on making that &lt;em&gt;extra&lt;/em&gt; difficult. At least her crew (and their cat) have her back.&lt;/p&gt;
&lt;p&gt;Or the Catradora rock star au that no one asked for.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>MalachiWalker</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra) (mentioned)</rdf:li>
          <rdf:li>Other Horde kids mentioned</rdf:li>
          <rdf:li>Alternate Universe - Rock Band</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Catra and the other hybrids are still furries</rdf:li>
          <rdf:li>because i make the rules</rdf:li>
          <rdf:li>Speculation on Magicat culture</rdf:li>
          <rdf:li>One unforgivable pun</rdf:li>
          <rdf:li>Catra has access to therapy</rdf:li>
          <rdf:li>But she's still CATRA</rdf:li>
          <rdf:li>Also Micah is her therapist</rdf:li>
          <rdf:li>"Mal is this au an excuse to imagine Catradora singing your favorite songs?"</rdf:li>
          <rdf:li>Yes.</rdf:li>
          <rdf:li>Rated T for Catra's (my) bad language</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Lonnie/Scorpia (She-Ra)</rdf:li>
          <rdf:li>Kyle/Rogelio (She-Ra) (not really focused on but it's there)</rdf:li>
        </rdf:Bag>
      </dc:subject>
