  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Lie There and Breathe</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Do you like gory injuries? Introspection? Clinging to the only thing that you can make sense of in a terrible situation? Then this is the fic for you!&lt;/p&gt;&lt;p&gt;An injured Horde Clone lies supine and sightless in an Etherian hospital tent after Horde Prime's defeat, while (mostly) alone with his thoughts the clone discovers an intense desire to survive, reasons his way out of panic, and makes a friend&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Lavender_Menace</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
