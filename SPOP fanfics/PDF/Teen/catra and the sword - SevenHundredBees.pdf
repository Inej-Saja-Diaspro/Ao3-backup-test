<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Catra and the Sword</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Originally posted as "Cat-Ra Fic #37".&lt;/p&gt;&lt;p&gt;The sword was never meant for her - but when her friend Adora is in danger, Catra uses it to become an unstoppable warrior. She sets out in search of a new life, but Adora swears to bring her back, no matter the cost...and with each fight, Catra's demons grow stronger, threatening to turn the power of She-Ra against the very people it was supposed to protect.&lt;/p&gt;&lt;p&gt;Based on the first season of She-Ra and the Princesses of Power.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>SevenHundredBees</rdf:li>
        </rdf:Seq>
      </dc:creator>
