<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Destiny and Other Lies</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;When Catra is finally given a mission to lead with her squad, things go horribly wrong. She lost her skiff and her data pad, but she found a magical sword....it's probably not related to that birthmark" on her wrist...that is starting to glow. &lt;/p&gt;&lt;p&gt;A magicatra/soulmates AU where Adora and Catra missed each other and Catra is Shera&lt;/p&gt;&lt;p&gt;Warnings for swearing, mentions of child abuse &lt;/p&gt;&lt;p&gt;*Please pardon any soulmate related errors, this is the first time I've written this type of fic!*&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>EmiliaGryphon</rdf:li>
        </rdf:Seq>
      </dc:creator>
