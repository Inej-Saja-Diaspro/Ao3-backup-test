<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">straying from the thunder</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Desperate and backed into a corner, Catra claims the Black Garnet for her own. This predictably blows up in her face, and now she has to pick up the pieces.&lt;/p&gt;&lt;p&gt;But maybe she wonâ€™t have to do it alone.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>enigmaticEditor</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Melog (She-Ra)</rdf:li>
          <rdf:li>Netossa (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Micah (She-Ra)</rdf:li>
          <rdf:li>Frosta (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>What-If</rdf:li>
          <rdf:li>Alternate Season/Series 05</rdf:li>
          <rdf:li>Black Garnet Catra</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Canon-Typical Violence</rdf:li>
          <rdf:li>Implied/Referenced Self-Harm</rdf:li>
          <rdf:li>because catra</rdf:li>
          <rdf:li>Suicidal Thoughts</rdf:li>
          <rdf:li>not just because of catra actually</rdf:li>
          <rdf:li>also major glitradora implications but not quite enough to be worth tagging</rdf:li>
          <rdf:li>this is romantic catradora and platonic glitra if only barely</rdf:li>
          <rdf:li>look glitradora + glimbow is the correct state of affairs</rdf:li>
          <rdf:li>and i will always write with that as the inevitable conclusion</rdf:li>
          <rdf:li>even if i don't quite get to it here</rdf:li>
