<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Mirror, Mirror</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;What if you could travel to a parallel Universe where something happened differently and the people you know are different versions of themselves, and some of them are their evil twins? &lt;/p&gt;
&lt;p&gt;Could this be everything that Catra ever wanted? Could Adora find everything she ever wanted too?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Pok Chookity (Pok_Chookity)</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
