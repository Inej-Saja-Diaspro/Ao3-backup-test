    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Any order you'd like</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora and Glimmer struggle with space, Bow and Catra discuss repairs, and everyone plays musical chairs (minus the music, plus control issues). &lt;/p&gt;&lt;p&gt;Or: Theyâ€™re intergalactic travelers. Standard road trip problems ensue. &lt;/p&gt;&lt;p&gt;Or: The captainâ€™s chair, nine ways.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
