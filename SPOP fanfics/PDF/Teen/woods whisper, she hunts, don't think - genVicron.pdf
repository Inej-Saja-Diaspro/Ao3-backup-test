<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Woods Whisper, She Hunts, Don't Think</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Most who lose their way in the Whispering Woods fight to escape.&lt;/p&gt;&lt;p&gt;Catra fought to sink further.&lt;/p&gt;&lt;p&gt;A name always brought her back.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>genVicron</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Lonnie (She-Ra)</rdf:li>
          <rdf:li>Major Character Injury</rdf:li>
          <rdf:li>Suicidal Ideation</rdf:li>
          <rdf:li>Post-mortal injury but still</rdf:li>
          <rdf:li>race against the clock</rdf:li>
          <rdf:li>Weird Whispering Woods headcanons</rdf:li>
          <rdf:li>Weird Runestone headcanons</rdf:li>
          <rdf:li>Narrative fun with tenses</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>Lonnie lives by virtue of Catra's issues being too knotted for the Woods to digest</rdf:li>
          <rdf:li>No editors we die with courage</rdf:li>
