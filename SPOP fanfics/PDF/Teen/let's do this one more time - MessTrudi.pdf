<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Let's do this one more time</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After the portal, Adora and Catra wake up in the past. As the only people remembering the future, they decide to change it. Well, Adora decides that and chooses to kidnap her former best friend. Surely, their relationship can only get better from here.&lt;/p&gt;
&lt;p&gt;Canon divergence that I'm sure has been done before, but I wrote it anyway.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>MessTrudi</rdf:li>
        </rdf:Seq>
      </dc:creator>
