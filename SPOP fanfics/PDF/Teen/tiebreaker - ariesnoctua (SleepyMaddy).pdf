<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">tiebreaker</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;5 times Catra tried to use the sword of protection to win, and one time she succeeded (sort of)&lt;/p&gt;&lt;p&gt;or: Catra, with Adoraâ€™s sword&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>ariesnoctua (SleepyMaddy)</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>other characters make an appearance but are not central</rdf:li>
          <rdf:li>5+1 Things</rdf:li>
          <rdf:li>POV Catra (She-Ra)</rdf:li>
          <rdf:li>POV Adora (She-Ra)</rdf:li>
          <rdf:li>sequences 1 to 5 cover scenes from the show</rdf:li>
          <rdf:li>in order:</rdf:li>
          <rdf:li>s1e9: No Princess Left Behind</rdf:li>
          <rdf:li>s1e11: Promise</rdf:li>
          <rdf:li>s2e5: White Out</rdf:li>
          <rdf:li>s3e3: Once Upon A Time In The Waste</rdf:li>
          <rdf:li>s3e4: Moment of Truth</rdf:li>
          <rdf:li>and then for the +1</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>technically number 5 isn't catra wielding the sword but</rdf:li>
          <rdf:li>close enough</rdf:li>
          <rdf:li>Angst with a Happy Ending</rdf:li>
          <rdf:li>technically? angst with a sharp turn into not-angst-at-all?</rdf:li>
          <rdf:li>catra's having a bad time but it gets better</rdf:li>
          <rdf:li>+1 is basically a post-canon fluff one shot</rdf:li>
          <rdf:li>it got away from me a bit</rdf:li>
          <rdf:li>this whole thing is mostly an excuse to give catra a sword</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2021-05-15T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
    <rdf:Description xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">
      <xmp:MetadataDate>2026-11-01T10:47:51.804454-03:00</xmp:MetadataDate>
    </rdf:Description>
