<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">I Love You</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Lord Adora is victorious.&lt;/p&gt;&lt;p&gt;Hordak has been killed, Brightmoon conquered, Prime defeated, and even She-Ra subdued. There's now nothing left standing between Adora and mastery of the whole universe, nothing except her kitten and her humanity.&lt;/p&gt;&lt;p&gt;Everyone she's ever loved has used her, abused her, reduced her, but she won't let them in anymore. Lord Adora has a duty to honour, a destiny to fulfill, and she has to do so no matter the cost...&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Catgirl_Soph</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Horde Adora (She-Ra)</rdf:li>
          <rdf:li>Horde Lord Adora (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Adora Remains with the Horde (She-Ra)</rdf:li>
          <rdf:li>Catra Leaves the Horde (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Catra is in Love with Adora (She-Ra)</rdf:li>
          <rdf:li>POV Catra (She-Ra)</rdf:li>
          <rdf:li>Magicat Catra (She-Ra)</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Hurt No Comfort</rdf:li>
          <rdf:li>Tragedy</rdf:li>
          <rdf:li>Why Did I Write This?</rdf:li>
          <rdf:li>Darkest Timeline</rdf:li>
          <rdf:li>I had to take a crying break while I wrote this</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Major Character Death</rdf:li>
          <rdf:li>Adora/Suffering</rdf:li>
          <rdf:li>Adora Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Adora Needs Therapy (She-Ra)</rdf:li>
        </rdf:Bag>
      </dc:subject>
