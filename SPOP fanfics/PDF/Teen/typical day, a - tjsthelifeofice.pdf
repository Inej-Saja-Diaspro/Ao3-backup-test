          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Unnamed Assassins</rdf:li>
          <rdf:li>Attempted Murder</rdf:li>
          <rdf:li>Assassination Attempt(s)</rdf:li>
          <rdf:li>Training</rdf:li>
          <rdf:li>Fluff and Humor</rdf:li>
          <rdf:li>Cute Kids</rdf:li>
          <rdf:li>Catra is a Surprisingly Good Mom Actually</rdf:li>
          <rdf:li>Bad Puns</rdf:li>
          <rdf:li>I'm Bad At Titles</rdf:li>
          <rdf:li>the floor is lava</rdf:li>
          <rdf:li>weaponized pool noodles</rdf:li>
          <rdf:li>Playing Pretend</rdf:li>
          <rdf:li>F/F</rdf:li>
