<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Scars Heal</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;On the night before their wedding, Catra starts spiraling after seeing the scars she left on Adora's back during the Battle of Bright Moon and thinking about how much she has hurt her. To help assure Catra that Adora doesn't mind the scars and that her love for Catra is unconditional, Glimmer tells her what happened in the immediate aftermath of the Battle of Bright Moon.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Mimmers</rdf:li>
        </rdf:Seq>
      </dc:creator>
