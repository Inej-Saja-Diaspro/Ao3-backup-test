<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">mahpiohanzia</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;mahpiohanzia - noun. "the frustration of being unable to fly, unable to stretch out your arms and vault into the air, having finally shrugged off the burden of your own weight, which you've been carrying your whole life without a second thought."&lt;/p&gt;&lt;p&gt;Adora spent five years physically fighting a war. She'll spend the rest of her life mentally stuck in it while watching everyone around her act like it never happened.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Lukaswritesthings</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Adora Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>Adora Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Hurt Adora (She-Ra)</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Hurt No Comfort</rdf:li>
          <rdf:li>Angst and Feels</rdf:li>
          <rdf:li>Self-Harm</rdf:li>
          <rdf:li>oh no adora has tinnitus</rdf:li>
          <rdf:li>oh no she has everything i have what a coincidence</rdf:li>
          <rdf:li>Author Is Sleep Deprived</rdf:li>
          <rdf:li>The Author Regrets Nothing</rdf:li>
          <rdf:li>The Author Regrets Everything</rdf:li>
          <rdf:li>Author Projecting onto Adora (She-Ra)</rdf:li>
          <rdf:li>POV Adora (She-Ra)</rdf:li>
          <rdf:li>Adora Has Issues (She-Ra)</rdf:li>
          <rdf:li>Post-Season/Series Finale</rdf:li>
          <rdf:li>author projecting so hard onto adora that next thing you know shes gonna have scoliosis</rdf:li>
          <rdf:li>shes my baby i made her she is mine</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Jealousy</rdf:li>
          <rdf:li>Jealous Adora (She-Ra)</rdf:li>
          <rdf:li>Unreliable Narrator</rdf:li>
          <rdf:li>Hatred</rdf:li>
          <rdf:li>Self-Hatred</rdf:li>
          <rdf:li>Feelings</rdf:li>
          <rdf:li>Adora is Bad at Feelings (She-Ra)</rdf:li>
          <rdf:li>technically set right before scorpias princess ball</rdf:li>
          <rdf:li>envy is the knife that stabs adora</rdf:li>
          <rdf:li>flight as a metaphor for joy and freedom</rdf:li>
          <rdf:li>never outright stated but scorpia and perfuma are together and practially adopted frosta</rdf:li>
          <rdf:li>Mentioned Perfuma (She-Ra)</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>adora has a guilt and inferiority complex</rdf:li>
          <rdf:li>i dont make the rules but actually i do</rdf:li>
          <rdf:li>i wanna make clear that catra is literally the only exception to adoras ideology</rdf:li>
          <rdf:li>its like that mha meme of "kacchan and the others"</rdf:li>
          <rdf:li>Mentioned Scorpia (She-Ra)</rdf:li>
          <rdf:li>I love her sm</rdf:li>
