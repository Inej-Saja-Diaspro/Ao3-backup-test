<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Power in You</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Calliope never belonged in the Horde and everyone knew it, especially her best friend, Lexie. She was bullied into almost complete silence before a mysterious occurrence pulls her away from everything she ever knew and discovers her true identity as well as a kingdom missing from the memories of Etheria. &lt;/p&gt;&lt;p&gt;Starts before the S3 Finale and intertwines the characters and plot into the series&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Pisces_Princess</rdf:li>
        </rdf:Seq>
      </dc:creator>
