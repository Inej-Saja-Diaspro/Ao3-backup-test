  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Revenge of the Fire Princess</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A mysterious figure from Etheria's past resurfaces after a thousand years, and the information they bring with them ends up straining Adora and Catra's relationship. Things get complicated when Adora discovers that she's carrying Catra's child.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Mimmers</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
