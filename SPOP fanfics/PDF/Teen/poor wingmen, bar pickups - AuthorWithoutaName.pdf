<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Poor Wingmen, Bar Pickups</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Teela and Adam are visiting Adora. Unlike her, the two of them love things like the nightlife and going out to bars to drink. Always feeling the need to be a good hostess, Adora takes them to a bar. There, she happens to see the most beautiful woman she's ever seen. Unfortunately, Adam has noticed too and has decided that his dear sister needs a wingman.&lt;/p&gt;&lt;p&gt;(Based on the SPOP Creative Flex server weekly prompt: Sibling Embarrassment)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>AuthorWithoutaName</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>He-Man | Adam &amp; Adora (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Adam &amp; Teela</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>He-Man | Adam</rdf:li>
          <rdf:li>Teela (He-Man)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Hordak (Mentioned)</rdf:li>
          <rdf:li>Modern AU</rdf:li>
          <rdf:li>Canon Species</rdf:li>
          <rdf:li>Alcohol</rdf:li>
          <rdf:li>Bars</rdf:li>
          <rdf:li>First Meeting</rdf:li>
          <rdf:li>Adam tries to be a wingman</rdf:li>
