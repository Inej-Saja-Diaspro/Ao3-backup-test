<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Stars Through the Snowstorm</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora had thought spending Christmas at her familyâ€™s cabin up in the mountains would be a relaxing break from high school. She did not expect to get snowed in up there, much less with no one but a sassy cat-eared alien castaway to keep her company. Forming an unlikely duo, Adora quickly finds herself at odds with her family and what seems like all the forces on Earth and in the stars above as she embarks on a cross-country quest to get her new friend home.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>MageofRadio</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Alternate Universe - Aliens</rdf:li>
          <rdf:li>Alien!Catra</rdf:li>
          <rdf:li>Human!Adora</rdf:li>
          <rdf:li>Road Trip!</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Other She-Ra Characters Appear</rdf:li>
          <rdf:li>Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora has a lot of anxiety</rdf:li>
          <rdf:li>Catra has a lot of trauma</rdf:li>
          <rdf:li>Castaway Catra</rdf:li>
          <rdf:li>Catra is stuck on a primitive planet</rdf:li>
          <rdf:li>And mad about it</rdf:li>
          <rdf:li>Humans are kind of insane</rdf:li>
          <rdf:li>Friendship</rdf:li>
          <rdf:li>Fluff and Angst</rdf:li>
          <rdf:li>Falling In Love</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>A Christmas fic like how Die Hard is a Christmas movie</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
