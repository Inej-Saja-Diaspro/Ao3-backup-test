<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">When the Night is Hard Again</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After being rescued from Horde Prime's ship, Catra needs alone time, and Adora won't let that happen. Catra needs to talk about what's going on in her mind and let her guard down, who better to listen than Adora?&lt;/p&gt;&lt;p&gt;AKA Catra has PTSD and the nightmares and flashbacks are so intense she can't get any sleep, Adora offers to be her support system (TW in the tags and at the beginning of the text)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>disasterchild314</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Catra Has Issues (She-Ra)</rdf:li>
          <rdf:li>Catra Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>Catra Needs A Hug</rdf:li>
          <rdf:li>TW-PTSD/CPTSD</rdf:li>
          <rdf:li>TW-Nightmare</rdf:li>
          <rdf:li>catra is touched starved</rdf:li>
          <rdf:li>hurt/comfort kinda</rdf:li>
          <rdf:li>more like hurt/comfort/then BIG hurt</rdf:li>
          <rdf:li>author is going through some stuff so please be nice &amp;lt;3</rdf:li>
          <rdf:li>please read the trigger warnings y'all</rdf:li>
          <rdf:li>right after catra is rescued from horde prime</rdf:li>
          <rdf:li>fluff?? technically</rdf:li>
          <rdf:li>No Smut</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
