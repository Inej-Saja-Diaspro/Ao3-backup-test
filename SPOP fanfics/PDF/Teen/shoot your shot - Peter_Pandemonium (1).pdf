<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Shoot Your Shot</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After the defeat of Prime, the Best Friend Squad (now featuring Catra) has been traveling through space to make sure any remaining clones are dealt with.  When a ship of rogue clones escapes and starts heading for a distant planet, the BFS pursues them.&lt;/p&gt;
&lt;p&gt;On Earth, Kate Bishop is trying to get back to some sense of normalcy.&lt;br /&gt;She has a job, and a dog, and maybe a slight crush on a certain unattainable blonde ex-assassin.&lt;/p&gt;
&lt;p&gt;On patrol one night, she crosses paths with some creepy looking dudes fighting with some very odd strangers.&lt;br /&gt;Little does she know that sheâ€™s about to get pulled into her biggest adventure yet.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Peter_Pandemonium</rdf:li>
        </rdf:Seq>
      </dc:creator>
