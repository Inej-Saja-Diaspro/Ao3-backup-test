<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Blond Spider</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora is Spidergirl. That's the story in three words.&lt;br /&gt;The actual thing will be way longer.&lt;/p&gt;&lt;p&gt;Basically Adora got bit same as every story.&lt;br /&gt;She's unsure about it all and tries to ignore it.&lt;br /&gt;Eventually she gives in and decides to use them to the best of her abilities.&lt;br /&gt;But with Glimmer Stark giving her a job that has her working on a suit two days a week, and her aunt Weaver is being.. Aunt Weaver..&lt;br /&gt;Can she really balance all that with her Heroic Duties?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Pitten</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Spider-Man - All Media Types</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora/Glimmer (She-Ra)(hinted)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow &amp; Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Angella &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Mara (She-Ra)</rdf:li>
          <rdf:li>Razz (She-Ra)</rdf:li>
          <rdf:li>tagswillbeaddedaswegoalong</rdf:li>
          <rdf:li>Very slow start</rdf:li>
          <rdf:li>Adora is Spider girl</rdf:li>
          <rdf:li>Abused Adora</rdf:li>
          <rdf:li>Bisexual Glimmer (She-Ra)</rdf:li>
          <rdf:li>Lesbian Adora (She-Ra)</rdf:li>
          <rdf:li>angella starts off on the wrong foot</rdf:li>
          <rdf:li>seriously a very slow start</rdf:li>
          <rdf:li>I can tell you right now Catra is Deadpool</rdf:li>
          <rdf:li>Multi</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>she won't be spidergirl until about 5 chapters in</rdf:li>
          <rdf:li>Catra first shows up in chapter 8</rdf:li>
          <rdf:li>Hordak</rdf:li>
          <rdf:li>Light Hope (She-Ra)</rdf:li>
          <rdf:li>Season 1</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
