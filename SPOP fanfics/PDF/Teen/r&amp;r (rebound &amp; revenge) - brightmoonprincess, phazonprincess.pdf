          <rdf:li>Angst</rdf:li>
          <rdf:li>Fluff and Humor</rdf:li>
          <rdf:li>Slow Burn</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
