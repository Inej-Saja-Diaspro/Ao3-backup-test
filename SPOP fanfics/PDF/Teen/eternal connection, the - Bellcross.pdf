<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Eternal Connection</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora has been having dreams. Dreams that she shouldn't be seeing. Dreams of her childhood. Of those who bore her. Of the one one who stole her. And of a baby... twins?!&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;Elsewhere, something dark awakens.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
