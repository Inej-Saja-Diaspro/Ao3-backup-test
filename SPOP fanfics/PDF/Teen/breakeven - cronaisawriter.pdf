<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Breakeven</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora and Catra were each other's rock, the stable force in a world that was uncaring and harsh. But when Adora is accepted to Grayskull Academy she is given a chance at whole other life, and their worlds are shifted for good. A life of heartbreak might not be the only option for Adora. But that doesn't help the ones left behind.&lt;br /&gt;Because when a heart breaks it doesn't break even.&lt;/p&gt;&lt;p&gt;Title based on the song Breakeven by the Script&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>cronaisawriter</rdf:li>
        </rdf:Seq>
      </dc:creator>
