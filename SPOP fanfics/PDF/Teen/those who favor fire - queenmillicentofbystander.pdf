<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Those Who Favor Fire</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora doesnâ€™t know she and Catra ever broke up. Catra doesnâ€™t believe Adora is ever coming back. &lt;/p&gt;&lt;p&gt;When Adora left Catra in their tiny town of Thaymor to play volleyball at the University of Bright Moon she made a promise. When Catra watched her drive away with nothing but false hope to keep her warm, she let Adora go. Now itâ€™s 8 years later. Adoraâ€™s an Olympic gold medalist, ready to keep her promise, and Catraâ€™s a high school music teacher, desperate for a peaceful winter break. But some promises are harder to keep than others, and peace on earth does not mean peace for you.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>queenmillicentofbystander</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Teen And Up Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora</rdf:li>
          <rdf:li>Catra</rdf:li>
          <rdf:li>Bow</rdf:li>
          <rdf:li>Glimmer</rdf:li>
          <rdf:li>Mara</rdf:li>
          <rdf:li>Razz</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Mermista (She-Ra)</rdf:li>
          <rdf:li>pretty much everyone makes an appearance at some point</rdf:li>
          <rdf:li>Yule Festival</rdf:li>
          <rdf:li>Basically I Wanted to Write a Princess Prom Scene</rdf:li>
          <rdf:li>Volleyball Player Adora</rdf:li>
          <rdf:li>Music Teacher Catra</rdf:li>
          <rdf:li>Childhood Friends</rdf:li>
          <rdf:li>Friends to Exes to Lovers</rdf:li>
          <rdf:li>But One of Them Doesn't Realize They Broke Up</rdf:li>
          <rdf:li>slow burn?</rdf:li>
          <rdf:li>probably gonna be angsty</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>lots of references</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>He-Man | Adam</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
