  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Long Time No See</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;An alternate universe of She-Ra if it were set in a High School AU.&lt;/p&gt;&lt;p&gt;Catra and Adora were both raised in the orphanage together until Adora left her. Years later, they see each other again... They start reconnecting again and building a new relationship, but with more complicated feelings.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>shirkzstuff09</rdf:li>
        </rdf:Seq>
      </dc:creator>
