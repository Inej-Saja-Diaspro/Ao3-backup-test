<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Genetic Composite</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Before Catra returned from the Crimson Wastes, Entrapta was working on a more permanent solution to fixing Hordak's problem. But then the whole portal debacle happened and in all the confusion, the experiment was left unattended.&lt;/p&gt;&lt;p&gt;Or, &lt;/p&gt;&lt;p&gt;In which so much shit hit so many fans and sprayed everywhere, no one in Etheria can make heads or tails of what's going on anymore and everyone's just running around trying to figure out what's in front of them at that moment.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>RenkonNairu</rdf:li>
        </rdf:Seq>
      </dc:creator>
