          <rdf:li>Mermista (She-Ra)</rdf:li>
          <rdf:li>Frosta (She-Ra)</rdf:li>
          <rdf:li>Not Canon Compliant</rdf:li>
          <rdf:li>No Hive Mind</rdf:li>
          <rdf:li>Higher ranked clones are allowed individuality</rdf:li>
          <rdf:li>Horde Clones</rdf:li>
          <rdf:li>Etheria/Eternia Bond</rdf:li>
        </rdf:Bag>
