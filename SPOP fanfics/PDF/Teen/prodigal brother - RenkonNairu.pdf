<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Prodigal Brother</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Everyone's heard the story of the Prodigal Son, whom leaves his home and squanders his resources. Exhausted and ashamed he returns home and is welcomed back by his family with open arms. &lt;/p&gt;&lt;p&gt;This is not that story. &lt;/p&gt;&lt;p&gt;Or, &lt;/p&gt;&lt;p&gt;In which Hordak takes the long road to figuring out what's really important to him and what he needs.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>RenkonNairu</rdf:li>
        </rdf:Seq>
      </dc:creator>
