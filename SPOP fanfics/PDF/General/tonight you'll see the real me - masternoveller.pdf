          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Lonnie (She-Ra)</rdf:li>
          <rdf:li>Rogelio (She-Ra)</rdf:li>
          <rdf:li>Magicat Catra (She-Ra)</rdf:li>
          <rdf:li>Human Catra</rdf:li>
          <rdf:li>Security Supervisor Catra</rdf:li>
          <rdf:li>Security Officer Lonnie</rdf:li>
          <rdf:li>And Rogelio and Scorpia</rdf:li>
          <rdf:li>Mention of Perfuma</rdf:li>
          <rdf:li>Mention of Glimmer - Freeform</rdf:li>
          <rdf:li>Mention of Bow</rdf:li>
          <rdf:li>halloween party</rdf:li>
