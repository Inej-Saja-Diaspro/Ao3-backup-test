    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A Painted Solstice</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora is going to do whatever she has to do to get Catra the perfect gift this Solstice from both her and Finn. Hand painted pottery is the way she is going to do it. Full of dinosaurs and Solstice spirit, Adora reflects on the life she and Catra have built.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Eviebebeevie</rdf:li>
        </rdf:Seq>
      </dc:creator>
