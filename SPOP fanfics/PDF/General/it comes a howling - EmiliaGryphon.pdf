<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">It Comes A Howling</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Requested by @Underthemoonlitday&lt;/p&gt;&lt;p&gt; Catra and her mother (do with that what you will) are the last ones. Mara is a wolf hunter employed by shadow Weaver to hunt wolves. She brings her adopted daughter adora with her. Adora sneaks into the woods and gets stuck in one of Mara's traps by accident and Catra tries to help her free herself as a wolf and ends up biting her. That night, Adora turns into a wolf as well and Catra teaches her how to be one&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>EmiliaGryphon</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>General Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Wolfwalkers (2020)</rdf:li>
          <rdf:li>Catra/Adora</rdf:li>
          <rdf:li>catradora - Relationship</rdf:li>
          <rdf:li>Adora &amp; Mara</rdf:li>
          <rdf:li>Shadow Weaver</rdf:li>
          <rdf:li>Adora</rdf:li>
          <rdf:li>Catra</rdf:li>
          <rdf:li>Werewolf AU</rdf:li>
          <rdf:li>Enemies to Friends to Lovers</rdf:li>
          <rdf:li>they are werewolves</rdf:li>
          <rdf:li>Werewolves</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>learning</rdf:li>
          <rdf:li>baby steps</rdf:li>
          <rdf:li>Hunting</rdf:li>
          <rdf:li>catra teaches adora how to be a werewolf</rdf:li>
          <rdf:li>also she bites her</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Mara</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Minor Character Death</rdf:li>
          <rdf:li>Pining</rdf:li>
          <rdf:li>Unresolved Emotional Tension</rdf:li>
          <rdf:li>Emotional Baggage</rdf:li>
