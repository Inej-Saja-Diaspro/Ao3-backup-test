          <rdf:li>General Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Queen C'yra of Half Moon</rdf:li>
          <rdf:li>King Felix of Half Moon</rdf:li>
          <rdf:li>Queen Angella</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Magicats - Character</rdf:li>
          <rdf:li>Post Season Theory</rdf:li>
          <rdf:li>Scorpia and Adora team up</rdf:li>
          <rdf:li>Rescue Missions</rdf:li>
          <rdf:li>Catra learns a bit more about herself</rdf:li>
          <rdf:li>Scorpia and Sea Hawk are bros</rdf:li>
          <rdf:li>Slow Burn</rdf:li>
          <rdf:li>First Kiss</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
