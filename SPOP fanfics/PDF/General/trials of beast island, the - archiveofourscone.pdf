<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Trials of Beast Island</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra wakes up again in a cell.&lt;br /&gt;Shadow Weaverâ€™s cell.&lt;br /&gt;She feels disoriented, and when she tries to pull herself up off the floor, her arms are weak, and she falls right back down to the floor.&lt;br /&gt;â€œOn your feet,â€ a voice says, and Catra turns her head to see Octavia standing in front of her cell, her lips pulled into a wicked smirk. â€œI have orders from Lord Hordak to send you to Beast Island,â€ Octavia says, â€œEffective immediately.â€&lt;/p&gt;&lt;p&gt;Catra gets sent to Beast Island for lying to Hordak, and Scorpia will do anything she can to save her best friend, even ask the Rebellion for help.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>archiveofourscone</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
