<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">She-Ra and the Crystal Gems: Rise of the Machines</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;In the wake of Skeletor's reign, Steven and the Crystal Gems find themselves stranded on Etheria, with no way home. However, a bad situation soon becomes worse when a new threat emerges, hell-bent on destroying everything in its way. Luckily, the Gems have a team of princesses on their side to help them defend the planet(s) from this enemy. Their greatest challenge begins now!&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>TheInkredibleKaptainKaiju</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>General Audiences</rdf:li>
          <rdf:li>Steven Universe (Cartoon)</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Steven Universe</rdf:li>
          <rdf:li>Connie Maheswaran</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Pearl (Steven Universe)</rdf:li>
          <rdf:li>Garnet (Steven Universe)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Mermista (She-Ra)</rdf:li>
          <rdf:li>Amethyst (Steven Universe)</rdf:li>
          <rdf:li>Frosta (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
