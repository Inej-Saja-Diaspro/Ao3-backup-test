<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">escapism</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;in which quite literally everything is the same except Catra sings "Escapism" from Steven Universe&lt;/p&gt;&lt;p&gt;also...a deep look at the inner psyche of a catgirl&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>adoras_braincell</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>General Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Lonnie (She-Ra)</rdf:li>
          <rdf:li>Kyle (She-Ra)</rdf:li>
          <rdf:li>Rogelio (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Octavia (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>POV Catra (She-Ra)</rdf:li>
          <rdf:li>Catra Character Study (She-Ra)</rdf:li>
          <rdf:li>a singing cat</rdf:li>
          <rdf:li>manifesting a catra song if we ever get a movie bc i think we deserve it</rdf:li>
          <rdf:li>Pre-Canon</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>a little bit of hurt/comfort</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>angst but nothing we don't see in the show</rdf:li>
          <rdf:li>shadow weaver's spectacular parenting skills but again nothing more than in the show</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
        </rdf:Bag>
      </dc:subject>
