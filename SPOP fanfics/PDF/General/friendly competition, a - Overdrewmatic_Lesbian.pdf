      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A Friendly Competition</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Itâ€™s time for the groups annual greeting card competition, an event that Catra has never real cared about. This year, however, she wants nothing more than to win, and she knows just what heartstrings she needs to pull to make it happen.&lt;/p&gt;&lt;p&gt;Part of the SPOP Flex Icebreaker Zine (link included in notes)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
