<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Master of the Universe</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;It's been a year or so since Adora found her birth family on the distant world of Eterina. When her brother Adam is a no-show for Bow and Glimmer's wedding, Adora starts to get worried. That worry proves justified, as Adam's nemesis Skeletor launches an attack on both their worlds in his ultimate plan to conquer the universe...&lt;/p&gt;&lt;p&gt;=======&lt;/p&gt;&lt;p&gt;Sequel to &lt;a href="https://archiveofourown.org/works/25116625" rel="nofollow"&gt;Secrets of the Sword&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Now complete!&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>inkpenavenger</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
