      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Fairytale Fiasco</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Glimmer accidently gets the Best Friend Squad trapped in a book of fairytales, and the only way to escape is to go through the books. It would be easier if they were all in the same story!&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
