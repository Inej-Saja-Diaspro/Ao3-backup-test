<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Mistakes Made, Mistakes Missed</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After the end of the war, Catra and Adora end up learning where the remnents of their old Squad from the Horde - Kyle, Rogelio, and Lonnie - Are, and at Scorpia's request, go to see them to try to talk about their history. After everything, Catra finds herself wanting to fix things - And finds herself seeing the same mistake she made happening all over again.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>QuirkQuartz</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
