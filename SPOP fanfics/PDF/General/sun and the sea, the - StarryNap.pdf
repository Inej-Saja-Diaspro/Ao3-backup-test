<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Sun and the Sea</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A year after the main events of Anchor, Adora looks at the life she has built with Catra and fights the memories of the past that still weigh over both of them. The path to healingis not lineal but they are getting there and they love each other&lt;/p&gt;&lt;p&gt;or&lt;/p&gt;&lt;p&gt;First Extra Short Story for Anchor. Happy Valentines Day [remember youÂ´ll need to read Anchor first to understand]&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>StarryNap</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
