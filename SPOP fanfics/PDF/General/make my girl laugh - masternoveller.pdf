      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Make my girl laugh</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Glimmer bets Catra can't make Adora laugh 10 days in a row. &lt;/p&gt;&lt;p&gt;Or &lt;/p&gt;&lt;p&gt;10 days of Catra attempting to make Adora laugh in different ways.&lt;/p&gt;&lt;p&gt;Or &lt;/p&gt;&lt;p&gt;Fluff (short Fluff)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
