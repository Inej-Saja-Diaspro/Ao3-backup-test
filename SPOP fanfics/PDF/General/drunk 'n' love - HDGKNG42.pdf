      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Drunk 'N' Love</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra is called to to the infirmary in Brightmoon by Glimmer. She was told that her girlfriend got into a bit of trouble while on a mission in space, but this wasn't what she had in mind.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
