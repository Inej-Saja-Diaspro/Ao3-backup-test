    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Red Jasper</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Five years after the war, new information tells the Princess Alliance that there is another runestone on Etheria. Lost to time and war it has been all but forgotten for many years. Now it's up to the Best Friend Squad to recover the runestone and uncover the mysteries it's shrouded in.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>lologoblens</rdf:li>
        </rdf:Seq>
      </dc:creator>
