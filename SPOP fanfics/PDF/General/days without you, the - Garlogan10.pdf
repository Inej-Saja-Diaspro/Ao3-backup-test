      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The days without you</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;What if Catra had died during the invasion? Horde Prime was defeated, Etheria was safe, the universe is safeâ€¦ but what will happen to Adora and her friends now?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
