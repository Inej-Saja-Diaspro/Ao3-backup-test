<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Fair Enough</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Entrapta is sure that the Shrieking Shack hides a fascinating story. Her schoolmates just had too many butterbeers and, in some cases, too much unresolved romantic tension going on.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Dodici</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>General Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Harry Potter - J. K. Rowling</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra &amp; Scorpia (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Emily &amp; Entrapta (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Emily (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Hogwarts</rdf:li>
          <rdf:li>Underage Drinking</rdf:li>
          <rdf:li>but it's actually butterbeer</rdf:li>
          <rdf:li>Unresolved Romantic Tension</rdf:li>
          <rdf:li>mention of Shadow Weaver's A+ parenting</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
