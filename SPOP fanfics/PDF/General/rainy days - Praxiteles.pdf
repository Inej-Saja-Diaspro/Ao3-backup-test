<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Rainy days</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;â€œDay 3: Catra has continued to refuse to leave her room after her meeting with Hordak, not even for food or progress reports. Scorpia and I will now attempt to feed her through the vents-â€&lt;/p&gt;&lt;p&gt;â€œCould you stop?â€&lt;/p&gt;&lt;p&gt;Entrapta, finally, clicks off the recorder and hides it deeper in her hair. Catraâ€™s voice was quiet and cracked, defeated. Entrapta seems to have understood that she couldnâ€™t handle much more.&lt;/p&gt;&lt;p&gt;or,&lt;br /&gt;Catra is the one to shut down the portal. Damaged, but alive, she's brought back to Brightmoon to heal and finally face the only person she ever loved.&lt;/p&gt;&lt;p&gt;or,&lt;br /&gt;This is my solution to what I have always assumed was a series of miscommunications on Adora's and Catra's part.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Praxiteles</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>General Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra &amp; Scorpia (She-Ra)</rdf:li>
          <rdf:li>Perfuma/Scorpia (She-Ra)</rdf:li>
          <rdf:li>Bow &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Mermista (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Disability</rdf:li>
          <rdf:li>Artist!Catra</rdf:li>
          <rdf:li>Adora just really loves her angry/hurt ball of fur.</rdf:li>
          <rdf:li>I love them both</rdf:li>
          <rdf:li>clear communication</rdf:li>
          <rdf:li>no misunderstandings</rdf:li>
          <rdf:li>Catra makes friends during her time in prison</rdf:li>
          <rdf:li>Colorblind Catra</rdf:li>
          <rdf:li>pain and suffering but then I kiss to make it better.</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2025-04-09T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
