          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Finn | Adora/Catra Child (She-Ra)</rdf:li>
          <rdf:li>Melog (She-Ra)</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Future Fic</rdf:li>
          <rdf:li>Alternate Universe - Future</rdf:li>
          <rdf:li>Minor Adora/Catra/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Married Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora Catra and Glimmer are in their 30s</rdf:li>
          <rdf:li>Finn is about 14</rdf:li>
          <rdf:li>Attics</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Journals</rdf:li>
          <rdf:li>Diary/Journal</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Adora is a Dork (She-Ra)</rdf:li>
          <rdf:li>Glimmer Has Wings (She-Ra)</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
