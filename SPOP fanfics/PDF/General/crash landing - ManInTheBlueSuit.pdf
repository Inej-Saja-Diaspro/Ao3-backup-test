<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Crash Landing</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Prime has no need for defects, and sentences an aberration to exile in a prototype ship on the most distant edges of his empire. It never expected to fall into a shadow dimension below reality, crashing into an isolated planet there, and being forced back to health against its will.&lt;/p&gt;
&lt;p&gt;Princess Entrapta is fascinated by the newcomer to her domain. They are completely unlike anyone else she has ever met. For one, he wishes to know about her theories. That he fell from the sky in a ship so far more advanced than anything on Etheria is equally as enticing.&lt;/p&gt;
&lt;p&gt;OR&lt;/p&gt;
&lt;p&gt;Hordak crashes into Dryll at the start of the series instead of long before. Written based on a Tumblr post by morallygrayautisticscientist with their permission.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>ManInTheBlueSuit</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>General Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Entrapta/Hordak (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Lab Partners</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Hordak Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Entrapta Being Entrapta (She-Ra)</rdf:li>
          <rdf:li>Gradual establishment of identity</rdf:li>
          <rdf:li>Entrapta/Hordak-centric (She-Ra)</rdf:li>
          <rdf:li>Autistic Entrapta (She-Ra)</rdf:li>
