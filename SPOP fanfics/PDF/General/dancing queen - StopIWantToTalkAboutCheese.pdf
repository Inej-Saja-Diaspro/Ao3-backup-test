    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">dancing queen</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra texts Adora.&lt;br /&gt;Adora texts back.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>StopIWantToTalkAboutCheese</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>General Audiences</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Perfuma/Scorpia (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Texting</rdf:li>
          <rdf:li>Falling In Love</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>by the way this series is now set in 2018</rdf:li>
          <rdf:li>bc i really really really dont want to have to deal w quarantine</rdf:li>
          <rdf:li>Unreliable Narrator</rdf:li>
          <rdf:li>Sort Of</rdf:li>
          <rdf:li>well its sort of hard to tell if either one is telling the truth</rdf:li>
          <rdf:li>because this is a textfic that i challenged myself to write and will probably never do again</rdf:li>
          <rdf:li>ive decided i hate not being able to get into their heads or use body language to help me out</rdf:li>
          <rdf:li>this was an interesting experience tho</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Modern Era</rdf:li>
          <rdf:li>Alternate Universe - Modern: No Powers</rdf:li>
