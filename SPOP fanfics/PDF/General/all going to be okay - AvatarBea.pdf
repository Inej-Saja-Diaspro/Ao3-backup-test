      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">All Going To Be Okay</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora and Catra find out that they are pregnant for the second time, this time Adora being the one to carry. This story follows the twists and turns that come their way.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
