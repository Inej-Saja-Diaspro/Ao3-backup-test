          <rdf:li>Finn | Adora/Catra Child (She-Ra)</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Alternate Universe - Modern with Magic</rdf:li>
          <rdf:li>Everyone is still the same species</rdf:li>
          <rdf:li>Modern Etheria (She-Ra)</rdf:li>
          <rdf:li>Football | Soccer</rdf:li>
          <rdf:li>Gardens &amp; Gardening</rdf:li>
          <rdf:li>Flowers</rdf:li>
          <rdf:li>Meet-Cute</rdf:li>
          <rdf:li>Alternate Universe - Neighbors</rdf:li>
          <rdf:li>Mentioned Adora/Catra</rdf:li>
          <rdf:li>Trans Perfuma (She-Ra)</rdf:li>
          <rdf:li>Trans Female Character</rdf:li>
