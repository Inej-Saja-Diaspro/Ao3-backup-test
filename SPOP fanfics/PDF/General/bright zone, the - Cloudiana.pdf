          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>Princess Catra (She-Ra)</rdf:li>
          <rdf:li>The First Ones (She-Ra)</rdf:li>
          <rdf:li>First Meetings</rdf:li>
          <rdf:li>Roleswap</rdf:li>
          <rdf:li>Horde Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora and Catra are Rebels</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
