<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Light that scared away the shadows</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Shadow Weaver expected to die, to finally be free of this world, all her attachments and failures. Yet the world did not seem to agree and now she has to live with the second chance, she did not expect and she wasn't even sure she wanted. She has to live with who she was and who she will be now. It meant redoing all the bad she had done, it meant she will see that the Horde had ruin more lives than just those of her cadets and former students.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Minervaas</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Castaspella/Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Castaspella &amp; Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Micah &amp; Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Castaspella &amp; Micah (She-Ra)</rdf:li>
          <rdf:li>Castaspella (She-Ra)</rdf:li>
          <rdf:li>Micah (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner Lives (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner Redemption (She-Ra)</rdf:li>
          <rdf:li>For the Love of Shadow Weaver</rdf:li>
          <rdf:li>Redemption</rdf:li>
          <rdf:li>Angst and Hurt/Comfort</rdf:li>
