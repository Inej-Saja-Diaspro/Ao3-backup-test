<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Catra's Past (Rewrite)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;We all know that Catra was found in a box by Adora in the Fright Zone when they were little. But how exactly did Catra end up in the Fright Zone to begin with? How did her story begin? Where did she come from? What events happened that lead to her growing up in the Fright Zone as a Horde Soldier?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Midnight_Owl2</rdf:li>
        </rdf:Seq>
      </dc:creator>
