          <rdf:li>LGBTQ</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Riko OC</rdf:li>
          <rdf:li>OC</rdf:li>
