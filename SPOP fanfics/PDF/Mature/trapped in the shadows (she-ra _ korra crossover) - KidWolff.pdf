          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Korra (Avatar)</rdf:li>
          <rdf:li>Asami Sato</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Orphans</rdf:li>
          <rdf:li>Orphanage</rdf:li>
          <rdf:li>Implied/Referenced Child Abuse</rdf:li>
          <rdf:li>Abuse</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Crossover</rdf:li>
          <rdf:li>High School</rdf:li>
