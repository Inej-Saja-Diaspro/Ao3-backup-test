<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">No love, No Light</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Shadow Weaver appears in Bright Moon hoping to gain the Rebellion's help for her vengeance on Hordak and discovers some shocking truths about herself. With the help of Queen Angella, she learns that power comes in many forms. Is it too late for her to learn them?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>OracleOfDestiny</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Angella/Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Perfuma/Scorpia (She-Ra)</rdf:li>
          <rdf:li>George/Lance (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Castaspella (She-Ra)</rdf:li>
          <rdf:li>Princess Alliance (She-Ra) - Character</rdf:li>
          <rdf:li>Huntara (She-Ra)</rdf:li>
          <rdf:li>Alternate Timelines</rdf:li>
          <rdf:li>Fix-It of Sorts</rdf:li>
          <rdf:li>Alternate Universe - Different First Meeting</rdf:li>
          <rdf:li>Romance</rdf:li>
          <rdf:li>Fluff and Angst</rdf:li>
          <rdf:li>I Wrote This Instead of Sleeping</rdf:li>
          <rdf:li>The Author Regrets Nothing</rdf:li>
          <rdf:li>Morally Ambiguous Character</rdf:li>
          <rdf:li>Unhealthy Coping Mechanisms</rdf:li>
          <rdf:li>Alternate History</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Implied/Referenced Self-Harm</rdf:li>
          <rdf:li>Implied/Referenced Child Abuse</rdf:li>
          <rdf:li>Emotional Manipulation</rdf:li>
          <rdf:li>Mild Language</rdf:li>
