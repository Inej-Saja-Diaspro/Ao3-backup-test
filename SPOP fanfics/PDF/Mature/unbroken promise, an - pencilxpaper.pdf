          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Horde Adora (She-Ra)</rdf:li>
          <rdf:li>Slow Burn</rdf:li>
          <rdf:li>Friends to Lovers</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Catra &amp; Scorpia (She-Ra)</rdf:li>
          <rdf:li>so much fluff for a Horde fic</rdf:li>
          <rdf:li>Sharing a Bed</rdf:li>
          <rdf:li>Adora &amp; Scorpia (She-Ra)</rdf:li>
          <rdf:li>For Want of a Nail</rdf:li>
          <rdf:li>Alternate Universe - Adora Remains with the Horde (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>Alternate Universe - Everyone Lives/Nobody Dies</rdf:li>
          <rdf:li>Longing</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Eventual Smut</rdf:li>
          <rdf:li>every cannon divergence you never knew you wanted</rdf:li>
