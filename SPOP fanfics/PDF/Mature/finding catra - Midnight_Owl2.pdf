<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Finding Catra</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora awakes to find that Catra and Melog are missing. She assumes that they have gone for a late night adventure so decides to go about her day as normal. However, as the day goes on Adora starts to worry that she hasn't heard anything from Catra. This is very unusual. It's only when Melog comes to find her that she realises that something is very, very wrong.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Midnight_Owl2</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Melog (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Swift Wind (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Razz (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Original Characters</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>catradora</rdf:li>
          <rdf:li>POV First Person</rdf:li>
          <rdf:li>Adora's POV</rdf:li>
          <rdf:li>Best Friend Squad (She-Ra)</rdf:li>
          <rdf:li>Visions</rdf:li>
          <rdf:li>Adora (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>Angella's Memorial (She-Ra)</rdf:li>
          <rdf:li>Memories</rdf:li>
          <rdf:li>Finding Halfmoon Series</rdf:li>
          <rdf:li>Finding Halfmoon Extra Chapter</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
