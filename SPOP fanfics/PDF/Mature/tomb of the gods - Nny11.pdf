          <rdf:li>Double Trouble (She-Ra)</rdf:li>
          <rdf:li>Other Additional Tags to Be Added</rdf:li>
          <rdf:li>Alternate Universe - Bloodborne Fusion</rdf:li>
          <rdf:li>Inspired by Bloodborne (Video Game)</rdf:li>
          <rdf:li>Don't Have to Know Bloodborne (Video Game)</rdf:li>
          <rdf:li>Insanity</rdf:li>
          <rdf:li>Blood and Violence</rdf:li>
          <rdf:li>Time Travel</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Dehumanization</rdf:li>
          <rdf:li>Double Trouble is an asshole (she-ra)</rdf:li>
          <rdf:li>Catra Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Canon-Typical Blood (Bloodborne)</rdf:li>
          <rdf:li>Canon-Typical Violence (Bloodborne)</rdf:li>
          <rdf:li>Adora Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Entrapta Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Everyone is having a super fun time for sure</rdf:li>
          <rdf:li>Angst with No Happy Ending</rdf:li>
        </rdf:Bag>
