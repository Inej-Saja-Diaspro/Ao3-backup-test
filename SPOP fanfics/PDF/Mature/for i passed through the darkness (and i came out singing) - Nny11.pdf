<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">For I Passed Through the Darkness (and I came out singing)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Beatrix glared down into the crib where her daughter slept. Not a child. Not a human. Not her baby, no, no, no. Her punishment. This was her punishment and Beatrix refused to accept it. She had done her best, she had only ever wanted to do her very best. This animal she had birthed would be trained. Would be taught. It would learn. And she would scream with her defiance as she took it and shaped it into a proper human.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Nny11</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Catra &amp; Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver PoV</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner's A+ Parenting</rdf:li>
          <rdf:li>Child Abuse</rdf:li>
          <rdf:li>To Train Up a Child referenced</rdf:li>
          <rdf:li>abuser perspective</rdf:li>
          <rdf:li>Adora and others are featured but are not the primary focus</rdf:li>
          <rdf:li>catradora endgame but not primary focus</rdf:li>
          <rdf:li>Abuse</rdf:li>
          <rdf:li>Physical Abuse</rdf:li>
          <rdf:li>Emotional/Psychological Abuse</rdf:li>
          <rdf:li>Shadow Weaver thinks she's the hero of this story but she isn't</rdf:li>
          <rdf:li>Angst with a Happy Ending</rdf:li>
          <rdf:li>Whump</rdf:li>
          <rdf:li>Heavy Angst</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Alternate Universe - No Powers</rdf:li>
          <rdf:li>Final Chapter is Catra's PoV</rdf:li>
          <rdf:li>Additional Tags to Be Added if Requested</rdf:li>
          <rdf:li>Dead Dove: Do Not Eat</rdf:li>
