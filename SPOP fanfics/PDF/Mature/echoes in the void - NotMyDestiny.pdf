          <rdf:li>Psychological Drama</rdf:li>
          <rdf:li>Suspense</rdf:li>
          <rdf:li>Emotional Hurt/Comfort</rdf:li>
          <rdf:li>Romantic Angst</rdf:li>
          <rdf:li>Angst with a Happy Ending</rdf:li>
          <rdf:li>Established Relationship</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>POV Alternating</rdf:li>
          <rdf:li>Protective Adora (She-Ra)</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Catra is in Love with Adora (She-Ra)</rdf:li>
