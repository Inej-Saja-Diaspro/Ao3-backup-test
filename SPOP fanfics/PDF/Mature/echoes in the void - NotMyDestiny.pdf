<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Echoes in the Void</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;In the quiet of space, nothing stays buried. When an ancient magic begins echoing their inner emotions and fears back at them, Adora clings to control, and Catra worries that sheâ€™ll only make things worse. To survive, theyâ€™ll have to stop running from who they used to be, and choose to trust each other, even when it hurts.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>NotMyDestiny</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
