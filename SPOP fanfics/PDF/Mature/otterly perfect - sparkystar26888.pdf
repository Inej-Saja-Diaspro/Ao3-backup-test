<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Otterly Perfect</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora has worked at the aquarium for a while now, and is pretty happy with her life. Catra works for a design and installment company, and was just assigned to an aquarium to help with an installation. They haven't talked to or seen each other for over a decade.&lt;/p&gt;&lt;p&gt;Wonder what will happen.&lt;/p&gt;&lt;p&gt;*Changed to M bc of chp 7 mainly&lt;/p&gt;&lt;p&gt;TLDR; trauma, angst, fluff, and slow burn all in one&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>sparkystar26888</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
