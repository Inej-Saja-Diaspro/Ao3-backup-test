    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">how things are supposed to be</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora and Catra have been best friends ever since they could remember. They want to spend their entire lives together. But according to Adora's mom, that's not how things are "supposed to be".&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>sapphocyra</rdf:li>
        </rdf:Seq>
      </dc:creator>
