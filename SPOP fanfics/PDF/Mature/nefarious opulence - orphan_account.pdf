<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">nefarious opulence</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Etheria, a modern world where three areas existed: the southern area, the neutral zone, and the northern one.&lt;/p&gt;&lt;p&gt;Adora and Catra had been born and raised in the gloomy streets of the neutral zone. But at 13 and 12 both are pulled to entirely different worlds. One went to the south while the other to the north. And now both must survive the new lives they got plunged into.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>orphan_account</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
