<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Waxing/Waning</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra successfully captures Adora at the Northern Reach, bringing her back as a prisoner to the Horde, along with She-ra's infected sword. The plan is simple: Use infected!She-ra to squash the Rebellion. But, things get complicated when Catra isn't the only one who wants control of Adora.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>ST_Thorns</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Post-Episode: s02e05 White Out</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Childhood Trauma</rdf:li>
          <rdf:li>Implied/Referenced Child Abuse</rdf:li>
          <rdf:li>Implied/Referenced Rape/Non-con</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Rape/Non-Con</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)'s A+ Parenting</rdf:li>
          <rdf:li>Friendship/Love</rdf:li>
          <rdf:li>drunk!Adora (She-Ra)</rdf:li>
          <rdf:li>infected!She-ra (She-ra)</rdf:li>
          <rdf:li>Happy Ending</rdf:li>
          <rdf:li>Complete</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
