    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A debt repaid</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra never really knew her life before Adora, she was her first memory. Catra always believed they would grow up with each other, but everything took a turn when Catra learned she could perform magic.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
