<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Hearts of Glass</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;(A companion piece to Tapestry of Time) Adora and Catra's lives are forever changed when Adora finds the Sword. They go their own ways and seek to forge their own destines apart.&lt;br /&gt;This is only the beginning of their journey back to each other.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Faded_Glory</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Kyle (She-Ra)</rdf:li>
          <rdf:li>Lonnie (She-Ra)</rdf:li>
          <rdf:li>Rogelio (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Razz (She-Ra)</rdf:li>
          <rdf:li>Swift Wind | Spirit</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Heartbreak</rdf:li>
          <rdf:li>Soul-Searching</rdf:li>
          <rdf:li>Friendship/Love</rdf:li>
          <rdf:li>Childhood Trauma</rdf:li>
          <rdf:li>Implied/Referenced Child Abuse</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>M/M</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2024-06-12T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
