<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Unbreakable Bulwark</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Before the Dr'adeths Coup.&lt;br&gt;Two Gangs, both alike in indignity,&lt;br&gt;In foul Wastes, where we lay our scene,&lt;br&gt;From ancient grudge break to new mutiny,&lt;br&gt;Where uncivil blood makes innocent hands unclean.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>tp9829, Zelenal</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Original Female Character/Original Trans Character</rdf:li>
          <rdf:li>Original Female Character/Original Female Character</rdf:li>
          <rdf:li>Vomiting</rdf:li>
          <rdf:li>Canon-atypical violence</rdf:li>
          <rdf:li>Unplanned Pregnancy</rdf:li>
          <rdf:li>Blood and Injury</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Threats of Violence</rdf:li>
          <rdf:li>Implied/Referenced Child Abuse</rdf:li>
