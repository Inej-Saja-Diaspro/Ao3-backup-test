<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Henchmen</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A fleshing out of the characters of &lt;i&gt;He-Man And The Masters Of The Universe&lt;/i&gt; with a more sensible and adult take. Chapter by chapter, the characters explore why they are affiliated with either Skeletor or Randor in a vastly more realistic and thought-out way than the animated children's series did. If you loved &lt;i&gt;Masters Of The Universe&lt;/i&gt; growing up and would like to see an adult version of your favorite characters played out every two weeks, check this out!  New chapters every other Thursday (next update May 25!).&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>WL_Swarts</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
