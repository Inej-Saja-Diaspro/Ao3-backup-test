<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Silent Tears</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A few weeks after the defeat of Horde Prime, Catra discovers that many of the experiences she believed to be mere hallucinations are all too real.&lt;/p&gt;&lt;p&gt;This begins right after Casting Out Shadows ends.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Paganaidd</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Castaspella (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Rape/Non-Con</rdf:li>
          <rdf:li>Past Rape/Non-con</rdf:li>
          <rdf:li>Rape Recovery</rdf:li>
          <rdf:li>Discussion of Abortion</rdf:li>
          <rdf:li>Abortion</rdf:li>
          <rdf:li>Melog (She-Ra)</rdf:li>
          <rdf:li>Safe and Legal</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner's A+ Parenting</rdf:li>
          <rdf:li>Tampering with contraceptive device</rdf:li>
          <rdf:li>Mentioned Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Therapy Cat Melog (She-Ra)</rdf:li>
          <rdf:li>Angst with a Happy Ending</rdf:li>
          <rdf:li>Angst and Hurt/Comfort</rdf:li>
          <rdf:li>Catra Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>Poor Catra (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>Catra Gets a Hug (She-Ra)</rdf:li>
          <rdf:li>Castaspella is a good Aunt</rdf:li>
          <rdf:li>Suicidal Thoughts</rdf:li>
          <rdf:li>Medical Procedures</rdf:li>
          <rdf:li>accurate medical procedures</rdf:li>
          <rdf:li>Hiding Medical Issues</rdf:li>
          <rdf:li>Unplanned Pregnancy</rdf:li>
          <rdf:li>Forced Pregnancy</rdf:li>
          <rdf:li>Safe Legal and Accessible</rdf:li>
          <rdf:li>Angst and Fluff and Smut</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>Eventual Smut</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
