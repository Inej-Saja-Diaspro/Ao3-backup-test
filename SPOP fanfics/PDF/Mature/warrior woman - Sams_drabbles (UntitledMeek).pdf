<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Warrior Woman</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;****INCOMPLETE****&lt;/p&gt;&lt;p&gt;Join General Adora in building a new life after crash landing on the mysterious planet, Etheria where she learns the truth about the demise of her home planet and must help her new friends in defeating a common foe lest the same fate that befell Eternia is brought onto Etheria. Along the way she learns new things about herself and learns to love with a fierce woman who compliments her in every way imaginable, but love isn't easy, especially for two soldiers who were taught to never fall in love.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Sams_drabbles (UntitledMeek)</rdf:li>
        </rdf:Seq>
      </dc:creator>
