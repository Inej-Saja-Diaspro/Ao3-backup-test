          <rdf:li>Randor (He-Man)</rdf:li>
          <rdf:li>Marlena (He-Man)</rdf:li>
          <rdf:li>Huntara (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Princess Adora (She-Ra)</rdf:li>
          <rdf:li>Magicat Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer is a good friend</rdf:li>
          <rdf:li>Bow Is a Good Friend (She-Ra)</rdf:li>
          <rdf:li>Huntara is a princess</rdf:li>
          <rdf:li>Adam and Teela are married</rdf:li>
          <rdf:li>Bow and Glimmer are together</rdf:li>
