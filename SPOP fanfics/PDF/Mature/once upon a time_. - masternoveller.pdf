<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Once Upon A Time...</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;This does not start with 'Once Upon A Time.'&lt;br /&gt;Just saying.&lt;br /&gt;But it does have a curse, princesses, princes, kings, queens, knights and a witch called Shadow Weaver here to ruin everything!&lt;/p&gt;&lt;p&gt;Or&lt;/p&gt;&lt;p&gt;Princess Adora agrees to marry Princess Huntara.&lt;br /&gt;Even though she doesn't really want to and is only doing out of duty.&lt;br /&gt;Will it work out or will there be a lot of spanners thrown in the works?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
