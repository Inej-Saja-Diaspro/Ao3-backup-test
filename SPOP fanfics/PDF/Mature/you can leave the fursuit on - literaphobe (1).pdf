<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">you can leave the fursuit on</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;five times adora hated catra's fursuit, and the one time she didn't.&lt;/p&gt;&lt;p&gt;Catra puts on a fursuit one day. This sends Adora spiraling and their relationship falls apart. But could the very thing that broke them apart also pull them back to each other?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>literaphobe</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>This is a crack fic</rdf:li>
          <rdf:li>okay please do not send me hate i am not a furry</rdf:li>
          <rdf:li>if you are a furry uh... i hope you like this?</rdf:li>
          <rdf:li>or i hope this doesn't offend u</rdf:li>
          <rdf:li>furries do not bully me</rdf:li>
          <rdf:li>non furries do not bully me</rdf:li>
          <rdf:li>i was peer pressured and threatened into writing this fic</rdf:li>
          <rdf:li>anyway welcome to the fccu</rdf:li>
          <rdf:li>fursuit catra cinematic universe</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2020-07-18T21:00:00-03:00</rdf:li>
