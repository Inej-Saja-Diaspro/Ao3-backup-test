    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Moon</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Finn, the moon of Catra and Adora, grapples with their past and present as they recount their life moments before it ends. No matter what, it all circles back to Aislin, the princess of Bright Moon, their best friend in life and death.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
