  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Barracks</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;All the pressure Adora had to endure growing up in the Fright Zone with her only goal being to please Shadow Weaver and become Force Captain. All the emotional trauma and gaslighting Catra had to endure with her only goal being to get some sort of recognition from Shadow Weaver. All the while their love for each other blooming against Shadow Weaver's orders&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>3AM_Reads</rdf:li>
        </rdf:Seq>
      </dc:creator>
