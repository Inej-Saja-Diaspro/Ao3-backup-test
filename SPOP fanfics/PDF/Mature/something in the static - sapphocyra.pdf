          <rdf:li>Minor or Background Relationship(s)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>other princesses mentioned - Character</rdf:li>
          <rdf:li>Catra-centric (She-Ra)</rdf:li>
          <rdf:li>POV Catra (She-Ra)</rdf:li>
          <rdf:li>Character Study</rdf:li>
          <rdf:li>gender expression</rdf:li>
          <rdf:li>gender and lesbianism...</rdf:li>
