<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Horde Control (2/2)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Part 2.&lt;/p&gt;&lt;p&gt;Blitz has shown the Horde what they fear the most: hope.&lt;/p&gt;&lt;p&gt;But he's only just begun.&lt;/p&gt;&lt;p&gt;He needs to give the Denizens throughout the Galaxy enough hope to turn against the Horde, V.I.L.E., and Exterminators.&lt;/p&gt;&lt;p&gt;Read as he continues his fight against the Evil Horde, gaining alliances of his own, and showing Horde Prime he's not a force to be reckoned with.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Cory_Ross_Gave_Up</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Helluva Boss (Web Series)</rdf:li>
          <rdf:li>Hazbin Hotel (Web Series)</rdf:li>
          <rdf:li>Gravity Falls</rdf:li>
