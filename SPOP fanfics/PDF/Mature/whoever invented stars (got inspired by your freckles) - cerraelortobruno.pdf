<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Whoever invented stars (got inspired by your freckles)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora realizes she's in love with Catra. Her nightmares are gone, replaced with images of her soul friend. She plans to do everything she couldn't do before with her: go on dates, kiss, get married... However, war still goes on... Heroes has no rest.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>cerraelortobruno</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Lesbian Adora (She-Ra)</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Fluff and Angst</rdf:li>
          <rdf:li>Catra is in Love with Adora (She-Ra)</rdf:li>
          <rdf:li>Catra is Bad at Feelings (She-Ra)</rdf:li>
          <rdf:li>Life in the Horde (She-Ra)</rdf:li>
          <rdf:li>Character Death</rdf:li>
          <rdf:li>Character Study</rdf:li>
          <rdf:li>Adora Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>Catra (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>Dorks in Love</rdf:li>
          <rdf:li>EVERYTHING GOES WRONG</rdf:li>
          <rdf:li>Disk Drunk | Infected Adora (She-Ra)</rdf:li>
          <rdf:li>Best Friend Squad (She-Ra)</rdf:li>
          <rdf:li>Dark Glimmer (She-Ra)</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Major Character Death</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
