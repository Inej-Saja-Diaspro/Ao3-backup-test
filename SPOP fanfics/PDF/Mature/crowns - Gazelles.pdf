<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Crowns</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora, the lost wanderer with a haunting past, finds knighthood thrust upon her. After the meeting of the princess and the resurfacing of old memories, she vows to be by her side forever. But many things are not as clear as they seem. As the relationship between them bloom into something bigger, they are forced to battle new and old enemies.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Gazelles</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Catra &amp; Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Royalty</rdf:li>
          <rdf:li>Queendoms</rdf:li>
          <rdf:li>Matriarchy</rdf:li>
          <rdf:li>Princesses</rdf:li>
          <rdf:li>Knights - Freeform</rdf:li>
          <rdf:li>Princess Catra (She-Ra)</rdf:li>
          <rdf:li>Knight Adora (She-Ra)</rdf:li>
          <rdf:li>Mother-Daughter Relationship</rdf:li>
          <rdf:li>Physical Abuse</rdf:li>
          <rdf:li>Emotional/Psychological Abuse</rdf:li>
