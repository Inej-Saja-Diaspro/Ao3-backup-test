<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">It Was Such a Bad Idea</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora and Catra have both just started their PhD programs in different cities and they've parted ways for the first time in 4 years. They try, and fail, to recover from everything they've gone through without each other, and have to reckon with their fates intertwining once again.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>billyspilgrimage</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - College/University</rdf:li>
          <rdf:li>grad school</rdf:li>
          <rdf:li>Friends to Enemies to Lovers</rdf:li>
          <rdf:li>Drinking</rdf:li>
          <rdf:li>Pining</rdf:li>
          <rdf:li>Camping</rdf:li>
          <rdf:li>late night labwork</rdf:li>
          <rdf:li>Useless Lesbians</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Mutual Pining</rdf:li>
          <rdf:li>Academia</rdf:li>
          <rdf:li>Slow Burn</rdf:li>
          <rdf:li>Emotional Hurt/Comfort</rdf:li>
          <rdf:li>I promise itll be worth it</rdf:li>
          <rdf:li>Lonnie (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Volleyball</rdf:li>
          <rdf:li>Swearing</rdf:li>
          <rdf:li>bow and glimmer are peripheral</rdf:li>
          <rdf:li>scorpia and perfuma are way more prominent than I had planned</rdf:li>
          <rdf:li>adora cant let herself be happy</rdf:li>
          <rdf:li>catra cant let down her walls for more than 2 seconds</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Smut in Chapter 18 but it's skippable</rdf:li>
          <rdf:li>My First Fanfic</rdf:li>
        </rdf:Bag>
      </dc:subject>
