<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Walk Forward With Me</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After the defeat of Horde Prime and the collapse of his empire, Etheria is finally free from chaos, and Adora and Catra are finally free from the cold grasp of war. For the first time in history, they can begin to fully explore their love for each other. The path forward isnâ€™t linear, or straightforward, and is clouded by the shadows of their war-torn pasts. But they have the undying support of each other and of the Best Friend Squad. They will brave it together.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>mesopphire</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
