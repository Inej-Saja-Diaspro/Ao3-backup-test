          <rdf:li>Between Episodes</rdf:li>
          <rdf:li>S5 E2: Launch</rdf:li>
          <rdf:li>Episode: s05e03 Corridors</rdf:li>
          <rdf:li>Why Did I Write This?</rdf:li>
          <rdf:li>Hurt No Comfort</rdf:li>
          <rdf:li>Maybe A Little Comfort If You Squint</rdf:li>
          <rdf:li>revenge porn</rdf:li>
          <rdf:li>Horde Prime's Ship (She-Ra)</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>Rape/Non-Con</rdf:li>
          <rdf:li>Horde Prime Being a Jerk (She-Ra)</rdf:li>
          <rdf:li>Solitary Confinement</rdf:li>
          <rdf:li>Imprisonment</rdf:li>
          <rdf:li>Non-Consensual Voyeurism</rdf:li>
          <rdf:li>Masturbation in Shower</rdf:li>
          <rdf:li>Masturbation</rdf:li>
          <rdf:li>non consensual exhibitionism</rdf:li>
