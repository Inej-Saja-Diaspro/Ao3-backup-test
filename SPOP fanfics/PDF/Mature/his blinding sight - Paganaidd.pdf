<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">His Blinding Sight</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;No sound of voices, machinery or even air movement marred the absolute quiet. When she thought too long about that, when she allowed herself to feel the silence, her whole self felt engulfed; she became insubstantial.&lt;/p&gt;&lt;p&gt;Glimmer's experience on Prime's ship.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Paganaidd</rdf:li>
        </rdf:Seq>
      </dc:creator>
