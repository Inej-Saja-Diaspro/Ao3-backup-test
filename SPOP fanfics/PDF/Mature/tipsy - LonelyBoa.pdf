<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Tipsy</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;If I never say a word, does it make it less true?&lt;/p&gt;&lt;p&gt;After the war, Catra and Adora navigate the repair of a broken world and a deeper intimacy with each other. Internalized anger towards herself makes Catra take three steps back for every step forward.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>LonelyBoa</rdf:li>
        </rdf:Seq>
      </dc:creator>
