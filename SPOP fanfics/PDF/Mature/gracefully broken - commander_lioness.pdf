<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Gracefully Broken</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;"Catra? Is that you?â€ Catra immediately looked up, leaned over Adora and said:&lt;/p&gt;&lt;p&gt;â€œYes. Itâ€™s me. Iâ€™m here.â€ Adora had never been more comforted in her life. She now remembered enough about what had happened to her to know that she was dying â€“ that something on Beast Island had killed her. And yet, in her final moments, Catra, the girl who she could never hate, and who she lived to see on the battlefield, was by her side.&lt;/p&gt;&lt;p&gt;OR&lt;/p&gt;&lt;p&gt;I know Catra saving Adora from a Horde-related lethal injury has been done so many times already, but I love the idea and want to contribute my version. That being said, there will be some smut (just kissing), a lot of mutual pining and, as always, a happy ending :)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>commander_lioness</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Swift Wind (She-Ra)</rdf:li>
          <rdf:li>Micah (She-Ra)</rdf:li>
          <rdf:li>Double Trouble (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra) Redemption</rdf:li>
          <rdf:li>Enemies to Lovers</rdf:li>
          <rdf:li>Mutual Pining</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>Amnesia</rdf:li>
          <rdf:li>Mermista (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner's A+ Parenting</rdf:li>
          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Netossa (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Frosta (She-Ra)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Despara (He-Man)</rdf:li>
          <rdf:li>Warning: Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Octavia (She-Ra)</rdf:li>
          <rdf:li>The Squad (She-Ra)</rdf:li>
          <rdf:li>Major Character Death</rdf:li>
          <rdf:li>Major Character Death: Hordak/ Horde Prime and Shadow Weaver</rdf:li>
          <rdf:li>(no one else dies)</rdf:li>
          <rdf:li>Catra and Adora are idiots in love</rdf:li>
          <rdf:li>Both of them nearly die</rdf:li>
          <rdf:li>They both need therapy and hugs</rdf:li>
          <rdf:li>Happy Ending</rdf:li>
          <rdf:li>Catradora Forever</rdf:li>
        </rdf:Bag>
