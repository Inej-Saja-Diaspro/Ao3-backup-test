<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">For The Woman Who Has Everything</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;While surprising Adora on her birthday, Catra and Glimmer find their friend with a strange alien plant attached to her body, keeping her in a trance-like state. As Adora finds herself in a  dream world where everything appears perfect, Catra and Glimmer have to fight against one of their oldest enemies, who has returned to take his long-awaited revenge on the saviours of Etheria. (Catradora, Canon, Angst/Hurt/Comfort, Based on the Justice League episode "For The Man Who Has Everything".)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>TheStarGayzingEtherianCollection (TheStarGayzingEtherian)</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Finn | Adora/Catra Child (She-Ra)</rdf:li>
          <rdf:li>Angella (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Canon</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Birthdays</rdf:li>
          <rdf:li>For The Man Who Has Everything (DC Comics)</rdf:li>
          <rdf:li>Based on a comic book and Justice League Episode</rdf:li>
