<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Ancient Grudges and Hokey Religions</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;The Outer Rim is, generally speaking, where you go to lose yourself. Pick a backwater world and just disappear. Empire, Republic, doesn't matter. None of them really care about what goes on out there. A great place to go when you don't want to be found.&lt;/p&gt;&lt;p&gt;Unless, of course, you're getting paid to go looking.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Rest_at_the_Bonfire</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Star Wars - All Media Types</rdf:li>
          <rdf:li>The Mandalorian (TV)</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Catra &amp; Entrapta (She-Ra)</rdf:li>
          <rdf:li>Bow &amp; Catra (She-Ra)</rdf:li>
          <rdf:li>Bow &amp; Entrapta (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Tung Lashor</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>One-shot</rdf:li>
          <rdf:li>unless it isn't</rdf:li>
          <rdf:li>probably won't be</rdf:li>
          <rdf:li>Crossover</rdf:li>
          <rdf:li>i'm in so much trouble now</rdf:li>
          <rdf:li>Sorry Not Sorry</rdf:li>
          <rdf:li>i will get back to the other thing i swear</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>Mermista/Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Mermista (She-Ra)</rdf:li>
          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>turns out it's not a one-shot after all</rdf:li>
          <rdf:li>we all knew this would happen</rdf:li>
          <rdf:li>let us accept it with quiet grace and dignity</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>Adora &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Razz (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Razz (She-Ra)</rdf:li>
          <rdf:li>lightsabers!</rdf:li>
          <rdf:li>jetpacks!</rdf:li>
          <rdf:li>brief cameos of my favorite melty blood characters!</rdf:li>
          <rdf:li>what else do you want</rdf:li>
          <rdf:li>really - Freeform</rdf:li>
        </rdf:Bag>
      </dc:subject>
