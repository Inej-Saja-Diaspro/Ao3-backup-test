<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Carcharodon Carcharias</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Itâ€™s nearing the Fourth of July weekend on Salineas Island, where Adora Brody is preparing to serve her first summer as the Sheriff of this tiny townâ€™s police department. Itâ€™s a big summer for the island, the 50th annual parade and celebration were sure to bring the largest smorgasbord yet-&lt;/p&gt;&lt;p&gt;Waitâ€¦ smorgasbord?&lt;/p&gt;&lt;p&gt;(My stupid little Jaws AU)&lt;/p&gt;&lt;p&gt;AN: Removing fic from AO3 Tuesday August 13th at 8 pm EDT&lt;/p&gt;&lt;p&gt;ACAB&lt;br /&gt;Abolish the police&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>cabbageboy</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Jaws References</rdf:li>
          <rdf:li>Light Angst</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Marine Biologist Catra</rdf:li>
          <rdf:li>Police Chief Adora</rdf:li>
          <rdf:li>I don't think there will be any on screen death honestly</rdf:li>
          <rdf:li>single mom adora</rdf:li>
          <rdf:li>Crack Treated Seriously</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>F/M</rdf:li>
