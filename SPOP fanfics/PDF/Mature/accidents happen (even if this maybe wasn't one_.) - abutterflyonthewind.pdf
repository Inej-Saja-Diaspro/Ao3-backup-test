      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">accidents happen (even if this maybe wasn't one...)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;to put it simply:&lt;/p&gt;&lt;p&gt;adora walks in on catra and lonnie and tries to figure out why she feels so strange.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>abutterflyonthewind</rdf:li>
        </rdf:Seq>
