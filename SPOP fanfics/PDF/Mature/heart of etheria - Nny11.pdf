<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Heart of Etheria</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Horde Prime seeks out an Ancient One, and sets off a chain of events that cannot be undone.&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;We are born of the blood, made men by the blood, undone by the blood. Our eyes are yet to open...fear the old blood.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Nny11</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Bloodborne Fusion</rdf:li>
          <rdf:li>Don't Have to Know Bloodborne (Video Game)</rdf:li>
          <rdf:li>Prime and his colonialist mind set are alive and well</rdf:li>
          <rdf:li>PoV Horde Prime</rdf:li>
          <rdf:li>Horde Prime Being a Jerk (She-Ra)</rdf:li>
          <rdf:li>Egotism on Display</rdf:li>
          <rdf:li>Bloodborne Lore Heavy</rdf:li>
          <rdf:li>Exposition</rdf:li>
          <rdf:li>the welcome to the AU fic</rdf:li>
          <rdf:li>no editing we die like meh</rdf:li>
          <rdf:li>who's bloodborne lore is it? everyone's and no one's the way god intended</rdf:li>
          <rdf:li>delicately sets the stage so I can crush my blorbos with a comically large angst hammer later</rdf:li>
          <rdf:li>Racism</rdf:li>
          <rdf:li>Minor Character Death</rdf:li>
          <rdf:li>the heart of etheria</rdf:li>
          <rdf:li>Blood Drinking</rdf:li>
          <rdf:li>Blood and Injury</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2022-10-05T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
    <rdf:Description xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">
      <xmp:MetadataDate>2026-11-01T10:20:32.859503-03:00</xmp:MetadataDate>
    </rdf:Description>
    <rdf:Description xmlns:calibreSI="http://calibre-ebook.com/xmp-namespace-series-index" xmlns:calibre="http://calibre-ebook.com/xmp-namespace" rdf:about="">
      <calibre:series rdf:parseType="Resource">
        <rdf:value>We are born of the blood</rdf:value>
        <calibreSI:series_index>1.00</calibreSI:series_index>
      </calibre:series>
