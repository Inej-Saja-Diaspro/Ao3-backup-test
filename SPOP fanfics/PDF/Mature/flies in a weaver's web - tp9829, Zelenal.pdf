    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Flies in a Weaver's Web</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Whilst Adora has been taken by the Horde, Halfmoon's spy network deals with their own troubles within the Horde ranks, and when an impossible mission to rescue the missing Knight lands in their lap, it seems like a suicide mission, or is it?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
