<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Blade in the Crowd</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Orphans taken in by Madame Weaver, Adora and Catra are thrust into an ages old war between two secret societies for the fate of humanity, while also learning of their own true nature.&lt;/p&gt;&lt;p&gt;â€”&lt;/p&gt;&lt;p&gt;Catradora in your average Assassins Creed plot&lt;/p&gt;&lt;p&gt;â€”&lt;/p&gt;&lt;p&gt;Note- This fic is AC newbie friendly. There are dream sequences which may be confusing, but prior knowledge is not required to enjoy the story. (Hopefully)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Ogjnogth</rdf:li>
        </rdf:Seq>
