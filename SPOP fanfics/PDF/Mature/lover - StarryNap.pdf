<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Lover</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;'Night runs them by and they love each other, they die for each other. And they are a whole world apart'&lt;/p&gt;&lt;p&gt;Or, Catra marries She-Ra, General of the Alliance and Goddess of Etheria's old world, to join the Horde and the Alliance against Horde Prime's forces. Except that Catra doesn't know who She-Ra really is, as she thinks She-Ra killed Adora in Thaymor three years ago. But the matters of the heart are complicated as are the strings that join soulmates and they'll guide Catra for paths she couldn't even phantom before&lt;/p&gt;&lt;p&gt;Or, Arranged Marriage/Secret Identity AU. Angst ensues.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>StarryNap</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Canon Divergence</rdf:li>
          <rdf:li>Arranged Marriage</rdf:li>
          <rdf:li>Secret Identity</rdf:li>
          <rdf:li>Adora is in Love with Catra (She-Ra)</rdf:li>
          <rdf:li>Catra is in Love with Adora (She-Ra)</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Catra thinks Adora is dead</rdf:li>
          <rdf:li>Past established Relationship</rdf:li>
          <rdf:li>Catra thinks She-Ra killed Adora</rdf:li>
          <rdf:li>Nobody knows Adora is She-Ra besides Bow and Glimmer</rdf:li>
          <rdf:li>Catra is very angry</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>The whole series has a happy ending</rdf:li>
          <rdf:li>But this work is just angst for now</rdf:li>
          <rdf:li>sorry - Freeform</rdf:li>
          <rdf:li>Adora loves Catra so very much</rdf:li>
          <rdf:li>Love Confessions</rdf:li>
          <rdf:li>Hate to Love</rdf:li>
          <rdf:li>Not Actually Unrequited Love</rdf:li>
          <rdf:li>heavy make outs</rdf:li>
          <rdf:li>No spicy times on this one</rdf:li>
          <rdf:li>Poor Catra give her a breath</rdf:li>
          <rdf:li>Also poor Adora someone hug her please</rdf:li>
          <rdf:li>Adora is so much better at She-Ra here</rdf:li>
          <rdf:li>She-Ra and Adora are the same person btw</rdf:li>
          <rdf:li>No magical spirit living inside Adora or nothing like that</rdf:li>
          <rdf:li>Just a depressed girl with magic powers on steroids</rdf:li>
          <rdf:li>Catra Needs Therapy (She-Ra)</rdf:li>
          <rdf:li>They both do</rdf:li>
          <rdf:li>Marriage of Convenience</rdf:li>
          <rdf:li>Kisses as an apology</rdf:li>
          <rdf:li>Other Additional Tags to Be Added</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2024-01-29T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
