<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Undesirable Beasts</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;The discovery of blood healing entailed the discovery of undesirable beasts, and reminds us of our adage.&lt;/p&gt;&lt;p&gt;We are born of the blood, made men by the blood, undone by the blood. Our eyes are yet to open. Fear the old blood.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Nny11</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Catra &amp; Melog (She-Ra)</rdf:li>
          <rdf:li>Catra &amp; Scorpia (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Melog (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Alternate Universe - Bloodborne Fusion</rdf:li>
          <rdf:li>Inspired by Bloodborne (Video Game)</rdf:li>
          <rdf:li>Don't Have to Know Bloodborne (Video Game)</rdf:li>
          <rdf:li>Catra Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Scorpia Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Melog is a literal little demon who wants two bagels</rdf:li>
          <rdf:li>Blood and Violence</rdf:li>
          <rdf:li>Blood</rdf:li>
          <rdf:li>institutionalization</rdf:li>
          <rdf:li>Unethical Experimentation</rdf:li>
          <rdf:li>Unethical Medicine</rdf:li>
          <rdf:li>Implied/Referenced Torture</rdf:li>
          <rdf:li>Aftermath of Torture</rdf:li>
          <rdf:li>Demonic Possession</rdf:li>
          <rdf:li>Cannibalism</rdf:li>
          <rdf:li>Cannibalistic Thoughts</rdf:li>
          <rdf:li>Blood Drinking</rdf:li>
          <rdf:li>Minor Character Death</rdf:li>
          <rdf:li>Self-Hatred</rdf:li>
          <rdf:li>Suicidal Thoughts</rdf:li>
          <rdf:li>Gen</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Disassociation</rdf:li>
          <rdf:li>Depersonalization</rdf:li>
          <rdf:li>Let me know if I forgot a tag goodness knows I most likely will!</rdf:li>
        </rdf:Bag>
