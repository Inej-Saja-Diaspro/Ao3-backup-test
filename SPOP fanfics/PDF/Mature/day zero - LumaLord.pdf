<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Day Zero</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;College kicks up and Adora and Catra find themselves roped in with the Best Friends Squad. But as Catra and Adora turns sour, will Adora have anyone to lean on, and may there be more to the BFS than first thought&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>LumaLord</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Glimmadora endgame</rdf:li>
          <rdf:li>Glimmer is a bisexual disaster</rdf:li>
          <rdf:li>College AU</rdf:li>
          <rdf:li>Unrequited Glimbow</rdf:li>
          <rdf:li>Toxic catradora</rdf:li>
          <rdf:li>Glimmer's mommy issues on full display</rdf:li>
          <rdf:li>Adora has mommy issues too</rdf:li>
          <rdf:li>Scorpia is a Good Friend (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow Friendship (She-Ra)</rdf:li>
          <rdf:li>Glimmer Needs a Hug (She-Ra)</rdf:li>
          <rdf:li>Adora needs a braincell</rdf:li>
          <rdf:li>Split Perspective</rdf:li>
          <rdf:li>glimmer swears a lot</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Major Character Death</rdf:li>
        </rdf:Bag>
