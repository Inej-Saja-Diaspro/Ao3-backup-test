<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Parallels</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Chapter 10 of SPACE CAPTAIN CATRA&lt;/p&gt;&lt;p&gt;Our two favourites are faced with choices, challenges and an ongoing look at their own tumultuous relationship.&lt;/p&gt;&lt;p&gt;Who will be caught in their wake as their cross-system rivalry simmers.&lt;/p&gt;&lt;p&gt;Adora looks to retake her lost ship; Catra looks to consolidate her hold on the system. The Rebels are down, but are they out? And what new threats may lurk in the darkness of space.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Jezmatron</rdf:li>
        </rdf:Seq>
      </dc:creator>
