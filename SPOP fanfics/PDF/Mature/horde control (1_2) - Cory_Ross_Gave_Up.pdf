<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Horde Control (1/2)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;In 2010, The Horde managed to take complete control of Etheria and made its way to find other planets to conquer.&lt;/p&gt;&lt;p&gt;Gaining alliances, they took over Earth and various other planets, forcing anyone they see into submission.&lt;/p&gt;&lt;p&gt;Horde Prime managed to take over Heaven and Hell.&lt;/p&gt;&lt;p&gt;The Exterminators are able to roam Hell freely.&lt;/p&gt;&lt;p&gt;Etheria's Princesses have been enslaved.&lt;/p&gt;&lt;p&gt;Hell's Royalty has been slain.&lt;/p&gt;&lt;p&gt;Rebellions, riots, protests, ended within minutes.&lt;/p&gt;&lt;p&gt;They're stealing the freedom of the majority.&lt;/p&gt;&lt;p&gt;It seems nobody can stand up to them.&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;Until now.&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;Heavily based on Wolfenstein.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Cory_Ross_Gave_Up</rdf:li>
        </rdf:Seq>
      </dc:creator>
