      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Fighting Sleep</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora was ready to die to save Etheria.&lt;br /&gt;She didn't.&lt;br /&gt;Now she has to make a new life for herself.&lt;/p&gt;&lt;p&gt;But it's difficult when she can't sleep.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
