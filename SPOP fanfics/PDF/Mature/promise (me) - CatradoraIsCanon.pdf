<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Promise (Me)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;The Horde is taking control of the planet Etheria, searching for the legendary warrior who shall bring peace to the universe, She-Ra. Adora is an orphan who discovers who she really is, with no clue why the Horde is looking for her. All she knows is; she has to stop them. With the help from her two best friends, Bow and Glimmer, Adora is searching for Horde Prime, the tyrant who destroys Etheria, to stop him and bring peace to the planet. But what happens when a certain cat comes into her life?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>CatradoraIsCanon</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
