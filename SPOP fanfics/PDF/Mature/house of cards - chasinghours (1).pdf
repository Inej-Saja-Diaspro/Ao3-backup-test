<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">house of cards</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra suddenly laughs, because what is she doing? Sheâ€™s a closeted lesbian who hasnâ€™t spoken to her family in years because of it, sheâ€™s struggling financially through grad school, she lives in a shitty apartment, and sheâ€™s just, essentially, offered to help a ghost figure out how to be a ghost.&lt;/p&gt;&lt;p&gt;But the hopeful look in Adoraâ€™s eyes is still there, and sheâ€™s wearing the first genuine smile Catraâ€™s ever seen on her, and sheâ€™s almost blindsided by how beautiful Adora is.&lt;/p&gt;&lt;p&gt;So Catra nods and says, â€œyeah. Iâ€™ll help you figure it out,â€ because really, how hard can it be?&lt;/p&gt;&lt;p&gt;(Really, she has no idea what sheâ€™s getting herself into.)&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>chasinghours</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra) (mentioned)</rdf:li>
          <rdf:li>Alternate Universe - Modern Setting</rdf:li>
          <rdf:li>Alternate Universe - Supernatural Elements</rdf:li>
          <rdf:li>Supernatural Elements</rdf:li>
          <rdf:li>Alternate Universe - 1990s</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Domestic Fluff</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Period-Typical Homophobia</rdf:li>
          <rdf:li>Ambiguous/Open Ending</rdf:li>
          <rdf:li>Comedy</rdf:li>
          <rdf:li>Ghost Adora</rdf:li>
          <rdf:li>this is simultaneously the funniest and angstiest thing iâ€™ve ever written</rdf:li>
          <rdf:li>Happy Halloween!</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>Bow &amp; Catra (She-Ra)</rdf:li>
        </rdf:Bag>
