<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">archimony</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora died the way she lived; sacrificing herself for the people she loved.&lt;br /&gt;It's only a couple days later, however, when Adora wakes up again.&lt;br /&gt;or; she-ra doesn't let those who grasp it's power rest. adora hates it.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Lukaswritesthings</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Mara &amp; She-Ra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Mara (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; She-Ra (She-Ra)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Catra &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow &amp; Glimmer (She-Ra)</rdf:li>
          <rdf:li>Adora &amp; Bow (She-Ra)</rdf:li>
