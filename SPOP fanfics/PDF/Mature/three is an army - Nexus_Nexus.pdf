    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Three is an Army</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Lonnie, Kyle, and Rogelio work together after the war ends to try and build a new life, but their discoveries about the world and all the lies within lead them towards a far darker path.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Nexus_Nexus</rdf:li>
        </rdf:Seq>
      </dc:creator>
