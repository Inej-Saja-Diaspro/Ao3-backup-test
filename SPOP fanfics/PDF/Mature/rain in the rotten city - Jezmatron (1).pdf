          <rdf:li>Sea Hawk (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Gumshoe</rdf:li>
          <rdf:li>Private Eye</rdf:li>
          <rdf:li>noir</rdf:li>
          <rdf:li>Detective Story</rdf:li>
          <rdf:li>Femme Fatale</rdf:li>
          <rdf:li>Mystery</rdf:li>
