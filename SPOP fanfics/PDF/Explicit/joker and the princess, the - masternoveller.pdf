<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Joker and The Princess</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra and Adora grew up together in a castle where Adora is a Princess and her parents are alive.&lt;br /&gt;Catra is framed for stealing and treason, resulting in a sentence of death.&lt;br /&gt;Shadow Weaver wants power. She wants to rid Adora and her family. But is she working alone or is this part of a bigger plot?&lt;/p&gt;
&lt;p&gt;Will our heroes be able to stop Shadow Weaver's plan?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>Randor (He-Man)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Marlena (He-Man)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Princess Adora (She-Ra)</rdf:li>
          <rdf:li>Magicat Catra (She-Ra)</rdf:li>
          <rdf:li>Oblivious Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra) Needs a Hug</rdf:li>
          <rdf:li>Jealous Catra (She-Ra)</rdf:li>
          <rdf:li>Manipulative Shadow Weaver | Light Spinner (She-Ra)</rdf:li>
          <rdf:li>catra joker</rdf:li>
          <rdf:li>Alternate Universe - Royalty</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Spinnerella (She-Ra)</rdf:li>
          <rdf:li>Netossa (She-Ra)</rdf:li>
          <rdf:li>Jealous Adora (She-Ra)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Protective Catra (She-Ra)</rdf:li>
          <rdf:li>Protective Adora (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
