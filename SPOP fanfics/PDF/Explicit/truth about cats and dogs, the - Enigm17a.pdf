  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Truth about Cats and Dogs</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora volunteers at an animal shelter as a way to destress from her job as a rookie for the Bright Moon fire department. She gets to hang out with cats and dogs and make their lives a little bit better. It's perfect! Or would be perfect were it not for Catra, the kennel manager with the stick up her butt.&lt;/p&gt;&lt;p&gt;or &lt;/p&gt;&lt;p&gt;The Catradora animal shelter fic we all have been waiting for. Maybe.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Enigm17a</rdf:li>
        </rdf:Seq>
      </dc:creator>
