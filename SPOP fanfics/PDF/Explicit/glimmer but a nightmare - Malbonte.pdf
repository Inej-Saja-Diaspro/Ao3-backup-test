<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Glimmer But A Nightmare</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;When her twin sister decides to return to Bright Moon, Queen Glimmer has to take care of bigger problems than the Horde. Because Princess Shimmer is literally a pain in the ass.&lt;/p&gt;&lt;p&gt;Glimmer knew it was a mistake to let her come back. Now, she has to stop her before she ruins her relationships and kingdom.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Malbonte</rdf:li>
        </rdf:Seq>
      </dc:creator>
