<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Responsibility: Pick a Nightmare and Run With It</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;A powerful potential threat arrives on Etheria's space-doorstep and nobody really has the time or energy for this shit. Catra gets pulled into an upsetting mystery while she tries to help her friends cope. Hordak won't admit how difficult it is to keep up with Etheria's, Entrapta's, and his own problems. The Alliance really hoped things would have gotten easier by now.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>AintGonnaHauntItself</rdf:li>
        </rdf:Seq>
      </dc:creator>
