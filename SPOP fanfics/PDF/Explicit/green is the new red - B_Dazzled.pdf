    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Green Is The New Red</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Entrapta finds herself on Primes ship at the end of season 4.&lt;br /&gt;The Emperor quickly takes a liking to her.&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;Is this a nice fic where nice things happen after season 4?&lt;/p&gt;&lt;p&gt;Nooo...... sorry.&lt;/p&gt;&lt;p&gt;Â &lt;/p&gt;&lt;p&gt;Will it have a happy ending? &lt;/p&gt;&lt;p&gt;Yes. Sort of. &lt;/p&gt;&lt;p&gt;Â &lt;br /&gt;&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
