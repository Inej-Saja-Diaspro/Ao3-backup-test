<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The war on our doorstep</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;&lt;b&gt;Adora Gray has been a war correspondent &lt;/b&gt;for nearly a decade, reporting from the front lines of todayâ€™s conflicts. Her signature blonde ponytail is well-known across the screens of the western hemisphere, her broadcasting platform reaching millions. &lt;/p&gt;&lt;p&gt;Now sheâ€™s in Mariupol, a city beleaguered by the Russian Army in the dictator Putinâ€™s attempt to conquer Ukraine. Resources are running out, and the situation is getting worse with each passing day. And despite the pleas of her friends and her mentor, she stays in the dying city.&lt;br /&gt;When sheâ€™s badly injured and brought to a hospital behind the front, a field surgeon with mismatched eyes and a biting attitude apparently saves her life, not just once.&lt;br /&gt;If only the damn woman wasnâ€™t on the wrong side.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>21st_tikonda</rdf:li>
        </rdf:Seq>
      </dc:creator>
