      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">(I) Liberate My Darkest Devotion</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After rescuing Catra from her fate, Scorpia is determined to keep Catra safe. This would be a lot easier if Catra didn't act like what happened to her wasn't a big deal.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
