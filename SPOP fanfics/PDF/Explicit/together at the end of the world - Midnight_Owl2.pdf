<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Together at the End of the World</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;What if Adora never found the Sword of Protection? What if Adora and Carta remained together in the Horde and worked their way to the top like they always promised? How would their story play out? What challenges lie ahead? Will Catra ever truly be able to tell Adora about her feeling for her?&lt;/p&gt;&lt;p&gt;Follow this journey written from Catraâ€™s POV as both individuals face the truth of the Hordes' destruction as well as coming to terms with their feelings for one another.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Midnight_Owl2</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
