<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Apoptosis</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;After being rescued from Beast Island by the princess alliance, Entrapta finds herself facing a new danger taking hold of her body.&lt;/p&gt;&lt;p&gt;You can take the princess out of Beast Island, but you can't take Beast Island out of the princess.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Madgirlmuahaha</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Entrapta/Hordak (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Micah (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Hanahaki but it's Beast Island nightmare plants</rdf:li>
          <rdf:li>Body Horror</rdf:li>
          <rdf:li>Illness</rdf:li>
          <rdf:li>Eventual Smut</rdf:li>
          <rdf:li>Romance</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>the princesses are trying to be better friends</rdf:li>
          <rdf:li>Beast Island nightmare vines</rdf:li>
          <rdf:li>F/M</rdf:li>
