<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Go the F to Sleep!</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;An overworked, stressed out Adora is refusing to sleep; nothing new there. Her wife, Catra, will do anything in her power to make sure Adora gets the rest she so needs... But not before easing all her tensions.&lt;/p&gt;&lt;p&gt;Or Catra puts Adora to bed, in all senses of the word.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>MxSinshine</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Bow (She-Ra)</rdf:li>
          <rdf:li>Glimmer (She-Ra)</rdf:li>
          <rdf:li>stubborn wife</rdf:li>
          <rdf:li>brattybottom</rdf:li>
          <rdf:li>Catragetscreative</rdf:li>
          <rdf:li>top!catra</rdf:li>
          <rdf:li>sleepisnotoverrated</rdf:li>
          <rdf:li>gothefucktosleep</rdf:li>
          <rdf:li>orelse</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Dom Catra (She-Ra)</rdf:li>
          <rdf:li>Sub Adora (She-Ra)</rdf:li>
          <rdf:li>Strap-Ons</rdf:li>
          <rdf:li>Strap Sucking</rdf:li>
          <rdf:li>Bondage</rdf:li>
          <rdf:li>Spanking</rdf:li>
          <rdf:li>Safewords</rdf:li>
          <rdf:li>Colorful pillow talk</rdf:li>
          <rdf:li>face down ass up</rdf:li>
          <rdf:li>It ends nice though.</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2020-10-19T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
