          <rdf:li>Scorpia (She-Ra)</rdf:li>
          <rdf:li>catradora</rdf:li>
          <rdf:li>Scorfuma</rdf:li>
          <rdf:li>College AU</rdf:li>
          <rdf:li>AU</rdf:li>
          <rdf:li>wlw</rdf:li>
          <rdf:li>mention of nudity</rdf:li>
          <rdf:li>Friendship</rdf:li>
          <rdf:li>Catra-Scorpia &amp; Adora-Perfuma frienship</rdf:li>
          <rdf:li>AU but Catra is still our beloved cat</rdf:li>
          <rdf:li>And Scorpia has her pincers and all</rdf:li>
          <rdf:li>Because I can't write them not having those</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
