<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">This Is My Future?</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Our power couple bump into another Catra from their past and decide to show her what she's been missing out on; namely a restrained Adora who'll take everything she can give.&lt;/p&gt;&lt;p&gt;Includes art by the beautiful &lt;a href="https://twitter.com/JustPigeonBlue" rel="nofollow"&gt;JustPigeonBlue&lt;/a&gt;&lt;/p&gt;</rdf:li>
