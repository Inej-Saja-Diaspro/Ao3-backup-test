<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">More Bat Than Usual</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;At the edge of the Whispering Woods, an Etherian wildlife researcher is investigating a recent trend of mutated fauna - likely a long-term side effect of the Great Magicsplosion that defeated Prime. One of her magical traps does contain a mutated new species... but not one of the native fauna she was expecting. &lt;/p&gt;&lt;p&gt;Shameless, plotless monsterf--kery with feral, winged spacebat; barely even connected to SPOP canon at this point. It's more like 'The Shape Of Water' meets 'How To Train Your Dragon' meets 'George of the Jungle' (...meets gratuitous spacebat smut).&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>LadyBinary</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Horde Prime Clones (She-Ra)/Original Character(s)</rdf:li>
          <rdf:li>Original Clone Character(s)</rdf:li>
          <rdf:li>Original Female Character(s)</rdf:li>
          <rdf:li>Gratuitous Smut</rdf:li>
          <rdf:li>Crack</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>Plot What Plot/Porn Without Plot</rdf:li>
          <rdf:li>Wings</rdf:li>
          <rdf:li>Wing Kink</rdf:li>
          <rdf:li>Wing Grooming</rdf:li>
          <rdf:li>Tails</rdf:li>
          <rdf:li>Feral Behavior</rdf:li>
          <rdf:li>Mutation</rdf:li>
          <rdf:li>Magic</rdf:li>
          <rdf:li>Human/Monster Romance</rdf:li>
          <rdf:li>Alternate Universe - Creatures &amp; Monsters</rdf:li>
          <rdf:li>Creature Fic</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>No Archive Warnings Apply</rdf:li>
          <rdf:li>Comedy</rdf:li>
          <rdf:li>Animal Traits</rdf:li>
