<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Stitched Up</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora is seriously injured in battle and loses the ability to transform into She-Ra because of it. During her lengthy recovery, Adora has to overcome her own trauma instilled by the Horde and learn to love herself for who she is, not for what she can do. Begins about six months after the finale.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Nordic_Fatcheese</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Adora (She-Ra)</rdf:li>
          <rdf:li>Catra (She-Ra)</rdf:li>
          <rdf:li>Perfuma (She-Ra)</rdf:li>
          <rdf:li>Castaspella (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>A bunch of other characters</rdf:li>
          <rdf:li>But I don't wanna flood the tags</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Graphic Depictions Of Violence</rdf:li>
          <rdf:li>Post-Canon</rdf:li>
          <rdf:li>Post-Traumatic Stress Disorder - PTSD</rdf:li>
          <rdf:li>Anxiety</rdf:li>
          <rdf:li>Depression</rdf:li>
          <rdf:li>Mentions of past abuse</rdf:li>
          <rdf:li>Implied Sexual Content</rdf:li>
          <rdf:li>No Character Death</rdf:li>
          <rdf:li>But lotsa pain</rdf:li>
          <rdf:li>Don't worry everyone will be fine</rdf:li>
          <rdf:li>Adora centric trauma</rdf:li>
          <rdf:li>Adora Goes to Therapy (She-Ra)</rdf:li>
          <rdf:li>gratuitous fluff</rdf:li>
          <rdf:li>Blood and Injury</rdf:li>
          <rdf:li>light self-harm</rdf:li>
          <rdf:li>but nothing too serious</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2021-09-05T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
