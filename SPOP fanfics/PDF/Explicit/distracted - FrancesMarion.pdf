<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Distracted</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Set in the middle of season two.&lt;/p&gt;&lt;p&gt;Entrapta works through the technical difficulties of being with someone nearly twice her size. Hordak realizes that there is more to sex than the emperor of the known universe had taught him. Neither of them has a clue about romantic relationships.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>FrancesMarion</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Entrapta/Hordak (She-Ra)</rdf:li>
          <rdf:li>Hordak (She-Ra)</rdf:li>
          <rdf:li>Entrapta (She-Ra)</rdf:li>
          <rdf:li>First Time</rdf:li>
          <rdf:li>Bondage</rdf:li>
          <rdf:li>Autistic Entrapta (She-Ra)</rdf:li>
          <rdf:li>F/M</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
          <rdf:li>Submissive Hordak (She-Ra)</rdf:li>
          <rdf:li>Horde Prime (She-Ra)</rdf:li>
          <rdf:li>M/M</rdf:li>
          <rdf:li>Hordak/Horde Prime (She-Ra)</rdf:li>
          <rdf:li>Sensory Overload</rdf:li>
          <rdf:li>Audio stimulation</rdf:li>
          <rdf:li>Mention of past experiences with Horde Prime</rdf:li>
          <rdf:li>For Science!</rdf:li>
          <rdf:li>Canon Autistic Character</rdf:li>
          <rdf:li>Genetically Engineered Compliance</rdf:li>
          <rdf:li>Mechanophilia</rdf:li>
          <rdf:li>Cervical Orgasms</rdf:li>
          <rdf:li>big dick problems</rdf:li>
          <rdf:li>lab partners with benefits</rdf:li>
          <rdf:li>Uneven Sexual Education</rdf:li>
          <rdf:li>Size Difference</rdf:li>
          <rdf:li>First Orgasm</rdf:li>
          <rdf:li>Stretching</rdf:li>
          <rdf:li>Canon Compliant</rdf:li>
          <rdf:li>[Parental Equivalent] Pressure to Procreate</rdf:li>
          <rdf:li>prehensile hair</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
