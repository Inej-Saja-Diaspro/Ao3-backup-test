  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Kingdom of Ash</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;The First Ones are not done with Etheria. Adora and the princesses must unite one last time to bring a lasting peace. As the past and future collide, Immortal Forces seek to control the Fate the Universe.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
