<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">promise</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;She expected it, her name was in the bowl 55th times. It was inevitable. Yet, hearing her name as the chosen tribute from District 7 still feels unreal. &lt;/p&gt;&lt;p&gt;She needs to survive, no matter what.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
