<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Always an Angel (Never a God)</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora would never tell Catra, or honestly anyone, how she felt. She could never tell the stories of what happened all those years ago in the dark corners of the fright zone, and she definitely canâ€™t show the way it effected her.&lt;br /&gt;First she was a Shadow Weaverâ€™s, child soldier, then a weapon, and now sheâ€™s just Adora.&lt;br /&gt;.&lt;br /&gt;Or, 5 times Adora hid what shadow weaver did to her, and the 1 time she didnâ€™t.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>unicorn_sparkles2006</rdf:li>
        </rdf:Seq>
      </dc:creator>
