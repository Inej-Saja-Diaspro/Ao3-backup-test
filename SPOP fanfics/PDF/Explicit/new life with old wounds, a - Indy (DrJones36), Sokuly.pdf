<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A New Life With Old Wounds</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Horde Prime is gone. One would think that would make life easier, but trauma from a war can still make some moments difficult to deal with months later.&lt;/p&gt;&lt;p&gt;Rebuilding Etheria is going to take a while and Catra wants to right her wrongs. Even if not many are pleased to see the old Horde commander.&lt;/p&gt;&lt;p&gt;Catra and Adora have always loved each other, they know that now that Shadow Weaver is gone. How can one simple thing become a little more complicated only a few months later? Not that Adora is complaining.&lt;/p&gt;&lt;p&gt;And how can a simple trip to Beast Island go so wrong and just create more questions than answers?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Indy (DrJones36), Sokuly</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
