<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Sisters Of The Road</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora just wants to buy a hot dog, look for work and take care of her found family. &lt;/p&gt;&lt;p&gt;Catra just wants to see the city, maybe make a few cents and rejoin her friends to venture off to another part of the country. &lt;/p&gt;&lt;p&gt;Neither of them expected to stick up a man with fresh hands, make off with a bounty, go on a string of dizzying dates with their ill gotten gains, and fall impossibly in love.&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>RaptorRed</rdf:li>
        </rdf:Seq>
      </dc:creator>
