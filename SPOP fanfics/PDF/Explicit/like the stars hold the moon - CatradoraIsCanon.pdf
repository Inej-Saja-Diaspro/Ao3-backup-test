<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Like The Stars Hold The Moon</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Senior year of high school is filled with love, drama and sex for Catra and Adora. Catra is the school's delinquent, whilst Adora is the star soccer player of The Rebellion. They lived two different lives, yet they are the two missing pieces they need to feel complete, they just haven't realized it yet. This is a story of betrayal, heartbreak and beautiful love.&lt;/p&gt;&lt;p&gt;--&lt;/p&gt;&lt;p&gt;READ THE TAGS BEFORE READING THIS, ALL THE CHARACTERS ARE IN A LEGAL AGE&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>CatradoraIsCanon</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Mature</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>Bow/Glimmer (She-Ra)</rdf:li>
