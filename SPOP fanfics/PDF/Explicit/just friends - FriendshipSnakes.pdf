<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Just Friends</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Adora and Catra have been best friends for a lifetime. They have a house together, a cat, and a group of wonderful friends. But after a series of terrible dates, Adora starts to give space to the feelings that have gone unnamed for years. Give feelings and inch, and they take a mile. Her once controlled feelings are quickly becoming overwhelming, and she has to make a decision. But Is it worth risking their friendship?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>FriendshipSnakes</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
