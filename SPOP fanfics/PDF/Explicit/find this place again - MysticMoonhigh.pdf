<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Find This Place Again</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;When Catra and Adora walk through a portal and onto an abandoned first ones' planet, they quickly realize that working together is their best option if they want to get home safely. Rising emotions and the allure of familiarity lead them into dangerous territory. Beneath it all simmers the question; Can they rekindle what they've lost on opposite sides of a war?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>MysticMoonhigh</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
          <rdf:li>She-Ra and the Princesses of Power (2018)</rdf:li>
          <rdf:li>Adora/Catra (She-Ra)</rdf:li>
          <rdf:li>(briefly mentioned) Bow/Glimmer</rdf:li>
          <rdf:li>Adora</rdf:li>
          <rdf:li>Catra</rdf:li>
          <rdf:li>Glimmer</rdf:li>
          <rdf:li>Bow</rdf:li>
          <rdf:li>Scorpia</rdf:li>
          <rdf:li>Entrapta</rdf:li>
          <rdf:li>Canon Divergence</rdf:li>
          <rdf:li>Canon Divergent</rdf:li>
          <rdf:li>Friends to Enemies to Lovers</rdf:li>
          <rdf:li>Banter</rdf:li>
          <rdf:li>Jokes</rdf:li>
          <rdf:li>Hurt/Comfort</rdf:li>
          <rdf:li>Angst</rdf:li>
          <rdf:li>Fluff</rdf:li>
          <rdf:li>as far as warnings go I chose not to use archive warnings</rdf:li>
          <rdf:li>there is a reason for that but it will be explained/easy to skip that scene</rdf:li>
          <rdf:li>Adora discovers her sexuality</rdf:li>
          <rdf:li>Lesbian Sex</rdf:li>
          <rdf:li>BDSM</rdf:li>
          <rdf:li>Bondage</rdf:li>
          <rdf:li>Oral</rdf:li>
          <rdf:li>memories in the horde</rdf:li>
          <rdf:li>Nostalgia</rdf:li>
          <rdf:li>F/F</rdf:li>
          <rdf:li>Choose Not To Use Archive Warnings</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Archive of Our Own</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2019-04-25T21:00:00-03:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
