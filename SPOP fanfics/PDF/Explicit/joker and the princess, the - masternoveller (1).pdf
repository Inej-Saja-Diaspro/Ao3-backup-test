<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Joker and The Princess</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">&lt;p&gt;Catra and Adora grew up together in a castle where Adora is a Princess and her parents are alive.&lt;br /&gt;Catra is framed for stealing and treason, resulting in a sentence of death.&lt;br /&gt;Shadow Weaver wants power. She wants to rid Adora and her family. But is she working alone or is this part of a bigger plot?&lt;/p&gt;
&lt;p&gt;Will our heroes be able to stop Shadow Weaver's plan?&lt;/p&gt;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>masternoveller</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Fanworks</rdf:li>
          <rdf:li>Explicit</rdf:li>
